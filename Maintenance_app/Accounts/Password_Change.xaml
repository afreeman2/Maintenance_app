<mah:MetroWindow  x:Class="Maintenance_app.Accounts.Password_Change"
                  xmlns:local="clr-namespace:Maintenance_app.Accounts"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                  xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
                  xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core" 
                  xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
                  Title="تغيير كلمة المرور" Width="540" Height="680"
                  WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
                  ShowInTaskbar="False" WindowStyle="None" AllowsTransparency="True" 
                  Background="Transparent" ShowTitleBar="False" ShowCloseButton="False"
                  ShowMinButton="False" ShowMaxRestoreButton="False" BorderThickness="0"
                  FontFamily="Segoe UI" FlowDirection="RightToLeft"
                  dx:ThemeManager.ThemeName="None" Loaded="Window_Loaded"
                  Closing="Window_Closing" UseLayoutRounding="True"
                  SnapsToDevicePixels="True">
    <mah:MetroWindow.Resources>
        <SolidColorBrush x:Key="MainBlue" Color="#0152A4" />
        <SolidColorBrush x:Key="TextDark" Color="#243447" />
        <SolidColorBrush x:Key="TextMuted" Color="#738195" />
        <Style x:Key="PasswordInput" TargetType="{x:Type dxe:PasswordBoxEdit}">
            <Setter Property="Height" Value="46" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="#DCE5EF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="PasswordChar" Value="•" />
            <Setter Property="ShowPasswordButtonVisibility" Value="Auto" />
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextDark}" />
        </Style>
        <Style x:Key="RoundedButton" TargetType="{x:Type Button}" BasedOn="{StaticResource Dmc.BaseButton}">
            <Setter Property="Height" Value="44" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="{StaticResource MainBlue}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
    </mah:MetroWindow.Resources>
    <Border Margin="10" Background="White" CornerRadius="18" BorderBrush="{StaticResource Dmc.Border}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="#142D4E" BlurRadius="18" ShadowDepth="3" Opacity="0.18" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="{StaticResource Workspace.Header}" CornerRadius="18,18,0,0" Padding="22" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid Margin="0,0,-22,0">
                    <Border Width="50" Height="50" CornerRadius="25" Background="#D2AB61" VerticalAlignment="Center" Margin="0,0,446,0">
                        <iconPacks:PackIconMaterial Kind="LockOutline" Width="26" Height="26" Foreground="{StaticResource Dcms.Primary}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                    </Border>
                    <TextBlock Text="تغيير كلمة المرور" Foreground="White" FontSize="23" FontWeight="Bold" Margin="65,7,184,3" />
                    <Button Width="33" Height="32" AutomationProperties.Name="إغلاق" Click="Cancel_Click" VerticalAlignment="Center" Style="{StaticResource RoundedButton}" x:Name="btnClose" ToolTip="اضغط للإلغاء واغلاق النافذة" Visibility="Visible" FontFamily="Segoe UI" FontSize="15" FontWeight="Bold" Foreground="White" HorizontalAlignment="Left" BorderBrush="{x:Null}" BorderThickness="0" Background="#32DF6363" Margin="453,0,0,0" Padding="0">
                        <iconPacks:PackIconBootstrapIcons Kind="XCircle" Foreground="White" Width="22" Height="22" />
                    </Button>
                </Grid>
            </Border>
            <StackPanel x:Name="formPanel" Grid.Row="1" Margin="24,22,24,10">
                <Border Background="#F3F7FC" CornerRadius="12" Padding="14" Margin="0,0,0,22">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="42" Height="42" Background="#E2EEFC" CornerRadius="21">
                            <iconPacks:PackIconMaterial Kind="Account" Width="23" Height="23" Foreground="{StaticResource Workspace.Header}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="المستخدم الحالي" Foreground="{StaticResource TextMuted}" FontSize="11" />
                            <TextBlock x:Name="txtCurrentUser" Text="المستخدم" Foreground="{StaticResource TextDark}" FontSize="16" FontWeight="SemiBold" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                </Border>
                <TextBlock Text="كلمة المرور الحالية" Style="{StaticResource FieldLabel}" />
                <dxe:PasswordBoxEdit x:Name="txtCurrentPassword" TabIndex="1" Style="{StaticResource PasswordInput}" dx:ThemeManager.ThemeName="Win11Light" NullText="أدخل كلمة المرور الحالية" EditValueChanged="PasswordField_EditValueChanged" Background="{StaticResource Dmc.FieldBackground}" BorderBrush="{StaticResource Dmc.Border}" Foreground="{StaticResource Dmc.Text}" CornerRadius="9" FontSize="14" />
                <TextBlock Text="كلمة المرور الجديدة" Style="{StaticResource FieldLabel}" Margin="0,20,0,0" />
                <dxe:PasswordBoxEdit x:Name="txtNewPassword" TabIndex="2" Style="{StaticResource PasswordInput}" dx:ThemeManager.ThemeName="Win11Light" NullText="أدخل كلمة المرور الجديدة" EditValueChanged="PasswordField_EditValueChanged" Background="{StaticResource Dmc.FieldBackground}" BorderBrush="{StaticResource Dmc.Border}" Foreground="{StaticResource Dmc.Text}" CornerRadius="9" FontSize="14" />
                <TextBlock Text="تأكيد كلمة المرور الجديدة" Style="{StaticResource FieldLabel}" Margin="0,20,0,0" />
                <dxe:PasswordBoxEdit x:Name="txtConfirmPassword" TabIndex="3" Style="{StaticResource PasswordInput}" dx:ThemeManager.ThemeName="Win11Light" NullText="أعد إدخال كلمة المرور الجديدة" EditValueChanged="PasswordField_EditValueChanged" Background="{StaticResource Dmc.FieldBackground}" BorderBrush="{StaticResource Dmc.Border}" Foreground="{StaticResource Dmc.Text}" CornerRadius="9" FontSize="14" />
                <Border x:Name="errorPanel" Visibility="Collapsed" Background="#FEF3F2" BorderBrush="#FECDCA" BorderThickness="1" CornerRadius="9" Padding="12" Margin="0,16,0,0">
                    <TextBlock x:Name="txtError" Foreground="#B42318" FontSize="12" TextWrapping="Wrap" />
                </Border>
            </StackPanel>
            <Border Grid.Row="2" BorderBrush="#E8EEF5" BorderThickness="0,1,0,0" Padding="24,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="110" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="btnSave" TabIndex="4" Style="{StaticResource RoundedButton}" IsDefault="True" Click="Save_Click">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="Check" Width="18" Height="18" Foreground="White" VerticalAlignment="Center" />
                            <TextBlock x:Name="txtSaveLabel" Text="حفظ كلمة المرور" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="btnCancel" Grid.Column="2" TabIndex="5" Style="{StaticResource RoundedButton}" Content="إلغاء" Background="{StaticResource Dmc.BlueSoft}" Foreground="{StaticResource TextDark}" BorderBrush="#E1E8F0" BorderThickness="1" IsCancel="True" Click="Cancel_Click" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</mah:MetroWindow>