<UserControl x:Class="Maintenance_app.Notifications.NotificationCenter"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core" xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
 xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks"  dx:ThemeManager.ThemeName="Win11Light" FlowDirection="RightToLeft" FontFamily="Segoe UI" FontSize="14">
 <UserControl.Resources>
  <ResourceDictionary>
  <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Maintenance_app;component/Resources/StaticChoices.xaml"/></ResourceDictionary.MergedDictionaries>
  <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
  <Style x:Key="Action" TargetType="dx:SimpleButton"><Setter Property="Height" Value="38"/><Setter Property="Margin" Value="3"/><Setter Property="Padding" Value="12,4"/></Style>
  <Style TargetType="ListBoxItem">
   <EventSetter Event="PreviewMouseLeftButtonDown" Handler="Notice_MouseDown"/>
   <EventSetter Event="PreviewMouseLeftButtonUp" Handler="Notice_Click"/>
   <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,8"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
    <Border x:Name="Row" BorderBrush="{Binding AccentColor}" BorderThickness="1" Background="{Binding TintColor}" CornerRadius="10"><ContentPresenter/></Border>
    <ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="#3559A0"/><Setter TargetName="Row" Property="Background" Value="#EDF2FA"/></Trigger>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="#7894BF"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  </ResourceDictionary>
 </UserControl.Resources>
 <Border Background="#F3F6FB" BorderBrush="#C4D1E5" BorderThickness="1" CornerRadius="16" Padding="20">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel><StackPanel Orientation="Horizontal"><icons:PackIconMaterial Kind="BellBadgeOutline" Width="27" Height="27" Foreground="#3559A0" Margin="0,0,10,0"/><TextBlock Text="مركز الإشعارات" FontSize="24" FontWeight="SemiBold" Foreground="#20375F"/></StackPanel>
     <TextBlock Text="متابعة طلبات الصيانة والتكليفات وتقارير الإنهاء" Foreground="#697C98" Margin="0,7,0,0"/></StackPanel>
    <dx:SimpleButton x:Name="CloseCenter" Grid.Column="1" Style="{StaticResource Action}" Click="Close_Click" ToolTip="إغلاق مركز الإشعارات" AutomationProperties.Name="إغلاق مركز الإشعارات"><icons:PackIconMaterial Kind="Close" Width="18" Height="18"/></dx:SimpleButton>
   </Grid>
   <!-- إحصاء مستقل لكل حالة، بنفس ألوان المجموعات والبطاقات. -->
   <UniformGrid Grid.Row="1" Columns="4" Margin="0,18,0,12">
    <Border Background="#233C67" CornerRadius="10" Padding="12" Margin="0,0,6,0"><StackPanel><TextBlock Text="تحتاج متابعة" Foreground="#D3DFF0"/><TextBlock Text="{Binding Total}" Foreground="White" FontSize="28" FontWeight="SemiBold"/></StackPanel></Border>
    <Border Background="#E5ECF9" CornerRadius="10" Padding="12" Margin="3,0"><StackPanel><TextBlock Text="بلا تقرير إنهاء" Foreground="#4D6385"/><TextBlock Text="{Binding NeedsReportCount}" Foreground="#2A497E" FontSize="28" FontWeight="SemiBold"/></StackPanel></Border>
    <Border Background="#FFF3DC" CornerRadius="10" Padding="12" Margin="3,0"><StackPanel><TextBlock Text="معلّقة" Foreground="#96620D"/><TextBlock x:Name="SuspendedCount" Text="{Binding SuspendedReportCount}" Foreground="#96620D" FontSize="28" FontWeight="SemiBold"/></StackPanel></Border>
    <Border Background="#E2F4F5" CornerRadius="10" Padding="12" Margin="6,0,0,0"><StackPanel><TextBlock Text="قيد الإنجاز" Foreground="#087F8C"/><TextBlock x:Name="InProgressCount" Text="{Binding InProgressReportCount}" Foreground="#087F8C" FontSize="28" FontWeight="SemiBold"/></StackPanel></Border>
   </UniformGrid>
   <Grid Grid.Row="2" Margin="0,0,0,8">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
    <Border BorderBrush="#A7B6CD" BorderThickness="1" CornerRadius="8" Margin="0,0,8,0">
     <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#DDE6F4"/><Style.Triggers><DataTrigger Binding="{Binding Search}" Value=""><Setter Property="Background" Value="White"/></DataTrigger></Style.Triggers></Style></Border.Style>
     <DockPanel><icons:PackIconMaterial Kind="Magnify" Width="19" Height="19" Margin="9" Foreground="#506F9E"/><dxe:TextEdit x:Name="NoticeSearch" EditValue="{Binding Search, UpdateSourceTrigger=PropertyChanged}" NullText="رقم الطلب أو التكليف، المبنى، الموظف أو الخدمة" Height="42" ShowBorder="False" Background="Transparent"/></DockPanel>
    </Border>
    <!-- مرشح محلي ثابت: إضافة الأيقونات لا تغير فهارس شروط التصفية. -->
    <dxe:ComboBoxEdit x:Name="NoticeFilter" Grid.Column="1" ItemsSource="{Binding Filters}" ItemTemplate="{StaticResource StaticChoice.Template}" SelectedIndex="{Binding Filter}" IsTextEditable="False" Height="44" HorizontalContentAlignment="Right" Background="#DDE6F4" BorderBrush="#7C95BC"/>
   </Grid>
   <DockPanel Grid.Row="3" Margin="0,0,0,8">
    <dx:SimpleButton x:Name="RefreshNotices" Style="{StaticResource Action}" Click="Refresh_Click"><StackPanel Orientation="Horizontal"><icons:PackIconMaterial Kind="Refresh" Width="18" Height="18" Margin="0,0,6,0"/><TextBlock Text="تحديث"/></StackPanel></dx:SimpleButton>
    <dx:SimpleButton x:Name="ReadAllNotices" Style="{StaticResource Action}" Click="ReadAll_Click"><StackPanel Orientation="Horizontal"><icons:PackIconMaterial Kind="CheckAll" Width="18" Height="18" Margin="0,0,6,0"/><TextBlock Text="تعيين الكل كمقروء"/></StackPanel></dx:SimpleButton>
    <CheckBox Content="التنبيهات المنبثقة" IsChecked="{Binding ToastsEnabled}" VerticalAlignment="Center" Margin="12,0"/>
    <CheckBox Content="الصوت" IsChecked="{Binding SoundEnabled}" VerticalAlignment="Center" Margin="4,0"/>
    <TextBlock Text="{Binding ResultLabel}" VerticalAlignment="Center" HorizontalAlignment="Left" Foreground="#667993"/>
   </DockPanel>
   <Grid Grid.Row="4">
    <!-- التحديد يعرض التفاصيل؛ القراءة تتم عند الفتح حتى لا يختفي الصف قبل اكتمال النقرة. -->
    <ListBox x:Name="NoticeList" ItemsSource="{Binding View}" SelectedItem="{Binding Selected}" PreviewKeyDown="Notice_KeyDown" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.IsVirtualizingWhenGrouping="True" VirtualizingPanel.VirtualizationMode="Recycling">
     <!-- تجميع فعلي حسب حالة العمل؛ يتبدل عنوان المجموعة وعددها تلقائيًا بعد كل تحديث. -->
     <ListBox.GroupStyle><GroupStyle>
      <GroupStyle.HeaderTemplate><DataTemplate>
       <Border Background="{Binding Items[0].TintColor}" BorderBrush="{Binding Items[0].AccentColor}" BorderThickness="0,0,0,2" CornerRadius="7" Padding="10,7" Margin="0,7,0,9">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <TextBlock Text="{Binding Name}" Foreground="{Binding Items[0].AccentColor}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"/>
         <Border Grid.Column="1" Background="White" CornerRadius="5" Padding="8,2" Margin="10,0,0,0"><TextBlock Text="{Binding ItemCount}" Foreground="{Binding Items[0].AccentColor}" FontWeight="SemiBold"/></Border>
        </Grid>
       </Border>
      </DataTemplate></GroupStyle.HeaderTemplate>
     </GroupStyle></ListBox.GroupStyle>
     <ListBox.ItemTemplate><DataTemplate><Grid Margin="14,11">
      <Grid.ColumnDefinitions><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Border Background="{Binding AccentColor}" CornerRadius="3"/>
      <StackPanel Grid.Column="1" Margin="10,0">
       <TextBlock Text="{Binding Title}" Foreground="{Binding AccentColor}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
       <TextBlock Text="{Binding Summary}" Foreground="#3A5174" Margin="0,6,0,0" TextWrapping="Wrap"/>
       <TextBlock Text="{Binding Employees}" Foreground="#73849D" Margin="0,4,0,0" TextWrapping="Wrap"/>
       <TextBlock Foreground="#73849D" Margin="0,4,0,0"><Run Text="{Binding Location}"/><Run Text=" • "/><Run Text="{Binding Branch}"/></TextBlock>
      </StackPanel>
      <StackPanel Grid.Column="2" Margin="12,0,0,0" HorizontalAlignment="Left">
       <Border Background="#E6EDFA" CornerRadius="6" Padding="8,3" Visibility="{Binding IsUnread, Converter={StaticResource BoolVisibility}}"><TextBlock Text="جديد" Foreground="#3559A0" FontSize="12"/></Border>
       <TextBlock Text="{Binding WaitingLabel}" Foreground="#9B6E2E" Margin="0,9,0,0" FontSize="12"/>
       <TextBlock Text="{Binding DateLabel}" Foreground="#7A8BA3" Margin="0,5,0,0" FontSize="12"/>
      </StackPanel>
     </Grid></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
    <TextBlock Text="لا توجد نتائج مطابقة" Foreground="#71839F" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
     <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding View.IsEmpty}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
    </TextBlock>
    <dx:WaitIndicator DeferedVisibility="{Binding IsBusy}" Content="جاري تحديث الإشعارات..." HorizontalAlignment="Center" VerticalAlignment="Center"/>
   </Grid>
   <Border Grid.Row="5" Background="White" CornerRadius="10" Padding="12" Margin="0,10,0,0" BorderBrush="#CBD7E8" BorderThickness="1">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel><TextBlock Text="{Binding Selected.Summary, TargetNullValue=اختر إشعارًا لعرض الطلب أو التكليف, FallbackValue=اختر إشعارًا لعرض الطلب أو التكليف}" Foreground="#294266" FontWeight="SemiBold" TextWrapping="Wrap"/>
      <TextBlock Text="{Binding Selected.Notes}" Foreground="#73849D" TextWrapping="Wrap" MaxHeight="50" Margin="0,5,0,0"/>
      <TextBlock Text="انقر مرتين على بطاقة إلغاء العميل لحذف إشعارها. إشعار الإنجاز يختفي بعد انتهاء تنبيهه." Foreground="#73849D" FontSize="12" Margin="0,5,0,0" TextWrapping="Wrap"/>
     </StackPanel>
     <StackPanel Grid.Column="1">
      <dx:SimpleButton x:Name="OpenNoticeOrder" Style="{StaticResource Action}" Background="#3559A0" Foreground="White" Click="Open_Click" IsEnabled="{Binding Selected.CanOpen, TargetNullValue=False, FallbackValue=False}"><StackPanel Orientation="Horizontal"><icons:PackIconMaterial Kind="ClipboardCheckOutline" Width="18" Height="18" Margin="0,0,6,0"/><TextBlock Text="{Binding Selected.OpenLabel, TargetNullValue=عرض المستند, FallbackValue=عرض المستند}"/></StackPanel></dx:SimpleButton>
      <dx:SimpleButton x:Name="ArchiveNoticeRequest" Style="{StaticResource Action}" Click="Archive_Click" Margin="0,8,0,0" Foreground="#B34747" IsEnabled="{Binding CanManageRequests}" Visibility="{Binding Selected.CanArchive, Converter={StaticResource BoolVisibility}, FallbackValue=Collapsed}"><StackPanel Orientation="Horizontal"><icons:PackIconMaterial Kind="DeleteOutline" Width="18" Height="18" Margin="0,0,6,0"/><TextBlock Text="حذف إشعار الإلغاء"/></StackPanel></dx:SimpleButton>
     </StackPanel>
    </Grid>
   </Border>
   <TextBlock Grid.Row="6" Text="{Binding Status}" Foreground="#697D99" TextWrapping="Wrap" Margin="0,10,0,0" FontSize="12"/>
  </Grid>
 </Border>
</UserControl>
