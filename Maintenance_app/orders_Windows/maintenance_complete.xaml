<?xml version="1.0" encoding="utf-8"?>
<mah:MetroWindow
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls" xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
 xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors" xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
 xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks" xmlns:converts="clr-namespace:Maintenance_app.converts"
 xmlns:orders="clr-namespace:Maintenance_app.orders_Windows" xmlns:vm="clr-namespace:Maintenance_app.viewo_Model"
 xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d" x:Class="Maintenance_app.orders_Windows.maintenance_complete"
 Title="تقرير إنهاء الصيانة" Width="1920" Height="1080" MinWidth="1000" MinHeight="700" FlowDirection="RightToLeft"
 WindowStartupLocation="CenterOwner" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
 ResizeMode="CanResize" WindowState="Maximized" FlyoutOverlayBrush="#90182948" ShowTitleBar="False" ShowCloseButton="False" ShowMinButton="False" ShowMaxRestoreButton="False"
 FontFamily="Segoe UI" FontSize="14" Loaded="Complete_Loaded" PreviewKeyDown="Complete_PreviewKeyDown" dx:ThemeManager.ThemeName="Win11Light">
    <mah:MetroWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Maintenance_app;component/Resources/StaticChoices.xaml" />
                <ResourceDictionary Source="/Maintenance_app;component/Resources/MaintenanceFlyouts.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <!-- لون الخانة الممتلئة يحدده وجود EditValue، دون المساس بالقيمة أو قواعد حفظها. -->
            <converts:InputHasValueConverter x:Key="Order.HasInputValue" />
            <SolidColorBrush x:Key="Order.FilledFieldBackground" Color="#DDE6F4" />
            <!-- حدود أوضح قليلًا في الحالات العادية والتحويم والامتلاء؛ يبقى لون التركيز الأقوى كما هو. -->
            <SolidColorBrush x:Key="Order.FieldBorder" Color="#A7B6CD" />
            <SolidColorBrush x:Key="Order.HoverFieldBorder" Color="#879DBC" />
            <SolidColorBrush x:Key="Order.FilledFieldBorder" Color="#7C95BC" />
            <converts:BooleanOrConverter x:Key="Order.ValidationVisible" />
            <!-- تحقق الخانات بأسلوب DCMS؛ طبقة الزينة لا تغير مقاسات الخانة أو قيمة الإدخال. -->
            <ControlTemplate x:Key="Order.FieldErrorTemplate">
                <StackPanel Orientation="Vertical" FlowDirection="RightToLeft">
                    <Border BorderThickness="2" BorderBrush="#DC000C" CornerRadius="8" VerticalAlignment="Top" Margin="-1">
                        <Grid>
                            <AdornedElementPlaceholder x:Name="adorner" />
                            <Polygon x:Name="errorCorner" Panel.ZIndex="2" Points="8,8 8,0 0,0" Fill="#DC000C" HorizontalAlignment="Right" VerticalAlignment="Top" />
                            <Polyline Panel.ZIndex="3" Points="7,7 0,0" HorizontalAlignment="Right" VerticalAlignment="Top" Stroke="White" StrokeThickness="1.5" IsHitTestVisible="False" />
                        </Grid>
                    </Border>
                    <Border x:Name="errorMessage" Background="#DC000C" Opacity="0" CornerRadius="3" IsHitTestVisible="False" MinHeight="24" MaxWidth="300" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding AdornedElement.(Validation.Errors)[0].ErrorContent, ElementName=adorner}" Foreground="White" Margin="8,3" TextWrapping="Wrap" FontWeight="SemiBold" />
                    </Border>
                </StackPanel>
                <ControlTemplate.Triggers>
                    <DataTrigger Value="True">
                        <DataTrigger.Binding>
                            <MultiBinding Converter="{StaticResource Order.ValidationVisible}">
                                <Binding ElementName="adorner" Path="AdornedElement.IsKeyboardFocusWithin" />
                                <Binding ElementName="errorCorner" Path="IsMouseOver" />
                            </MultiBinding>
                        </DataTrigger.Binding>
                        <Setter TargetName="errorMessage" Property="Opacity" Value="1" />
                    </DataTrigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
            <SolidColorBrush x:Key="Order.Accent" Color="#3559A0" />
            <Style x:Key="Order.ChromeIcon" TargetType="{x:Type icons:PackIconMaterial}">
                <Setter Property="Width" Value="18" />
                <Setter Property="Height" Value="18" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type dx:SimpleButton}}}" />
                <Setter Property="IsHitTestVisible" Value="False" />
                <Setter Property="Focusable" Value="False" />
            </Style>
            <!-- مفتاح التفعيل بجوار الخانة مباشرة؛ تاريخا الفترة يشتركان في تفعيل واحد. -->
            <Style x:Key="Complete.FilterToggle" TargetType="{x:Type CheckBox}">
                <Setter Property="FontSize" Value="{DynamicResource Order.LabelFont}"/>
                <Setter Property="Foreground" Value="#4A5874"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Margin" Value="0"/>
                <Setter Property="MinHeight" Value="18"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <EventSetter Event="ToggleButton.Checked" Handler="SearchFilter_Changed"/>
                <EventSetter Event="ToggleButton.Unchecked" Handler="SearchFilter_Changed"/>
            </Style>
            <Style x:Key="FieldLabel" TargetType="{x:Type TextBlock}">
                <Setter Property="FontSize" Value="{DynamicResource Order.LabelFont}" />
                <Setter Property="Foreground" Value="#4A5874" />
                <Setter Property="Margin" Value="{DynamicResource Order.LabelGap}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style TargetType="{x:Type dxe:ComboBoxEdit}">
                <EventSetter Event="dxe:LookUpEditBase.SelectedIndexChanged" Handler="Input_SelectionChanged" />
                <EventSetter Event="dxe:LookUpEditBase.PopupContentSelectionChanged" Handler="Input_SelectionChanged" />
                <!-- لا تحقق تلقائيًا أثناء الكتابة؛ الخطأ يوضع صراحة عند تنفيذ الأمر ويزال عند تعديل القيمة. -->
                <Setter Property="ValidateOnTextInput" Value="False" />
                <Setter Property="ValidateOnEnterKeyPressed" Value="False" />
                <Setter Property="InvalidValueBehavior" Value="AllowLeaveEditor" />
                <EventSetter Event="dxe:BaseEdit.EditValueChanged" Handler="Input_EditValueChanged" />
                <EventSetter Event="dxe:BaseEdit.EditValueChanging" Handler="Input_EditValueChanging" />
                <EventSetter Event="UIElement.PreviewTextInput" Handler="Input_PreviewTextInput" />
                <Setter Property="Height" Value="{DynamicResource Order.FieldHeight}" />
                <Setter Property="FontSize" Value="{DynamicResource Order.FieldFont}" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="AutoComplete" Value="True" />
                <Setter Property="IncrementalFiltering" Value="True" />
                <Setter Property="IsTextEditable" Value="True" />
                <Setter Property="NullText" Value="اختر من القائمة" />
                <Setter Property="Background" Value="#FCFBF8" />
                <Setter Property="Foreground" Value="#253A62" />
                <Setter Property="BorderBrush" Value="{StaticResource Order.FieldBorder}" />
                <Setter Property="BorderThickness" Value="1" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="BorderBrush" Value="{StaticResource Order.HoverFieldBorder}" />
                        <Setter Property="Background" Value="#F4F6FB" />
                    </Trigger>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                        <Setter Property="BorderBrush" Value="#3559A0" />
                        <Setter Property="Background" Value="White" />
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style TargetType="{x:Type dxe:TextEdit}">
                <!-- لا تحقق تلقائيًا أثناء الكتابة؛ الخطأ يوضع صراحة عند تنفيذ الأمر ويزال عند تعديل القيمة. -->
                <Setter Property="ValidateOnTextInput" Value="False" />
                <Setter Property="ValidateOnEnterKeyPressed" Value="False" />
                <Setter Property="InvalidValueBehavior" Value="AllowLeaveEditor" />
                <EventSetter Event="dxe:BaseEdit.EditValueChanged" Handler="Input_EditValueChanged" />
                <EventSetter Event="dxe:BaseEdit.EditValueChanging" Handler="Input_EditValueChanging" />
                <EventSetter Event="UIElement.PreviewTextInput" Handler="Input_PreviewTextInput" />
                <Setter Property="Height" Value="{DynamicResource Order.FieldHeight}" />
                <Setter Property="FontSize" Value="{DynamicResource Order.FieldFont}" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Background" Value="#FCFBF8" />
                <Setter Property="Foreground" Value="#253A62" />
                <Setter Property="BorderBrush" Value="{StaticResource Order.FieldBorder}" />
                <Setter Property="BorderThickness" Value="1" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="BorderBrush" Value="{StaticResource Order.HoverFieldBorder}" />
                        <Setter Property="Background" Value="#F4F6FB" />
                    </Trigger>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                        <Setter Property="BorderBrush" Value="#3559A0" />
                        <Setter Property="Background" Value="White" />
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style TargetType="{x:Type dxe:SpinEdit}">
                <!-- لا تحقق تلقائيًا أثناء الكتابة؛ الخطأ يوضع صراحة عند تنفيذ الأمر ويزال عند تعديل القيمة. -->
                <Setter Property="ValidateOnTextInput" Value="False" />
                <Setter Property="ValidateOnEnterKeyPressed" Value="False" />
                <Setter Property="InvalidValueBehavior" Value="AllowLeaveEditor" />
                <EventSetter Event="dxe:BaseEdit.EditValueChanged" Handler="Input_EditValueChanged" />
                <EventSetter Event="dxe:BaseEdit.EditValueChanging" Handler="Input_EditValueChanging" />
                <EventSetter Event="UIElement.PreviewTextInput" Handler="Input_PreviewTextInput" />
                <Setter Property="Height" Value="{DynamicResource Order.FieldHeight}" />
                <Setter Property="FontSize" Value="{DynamicResource Order.FieldFont}" />
                <Setter Property="MinValue" Value="0" />
                <Setter Property="Mask" Value="n3" />
                <Setter Property="MaskUseAsDisplayFormat" Value="True" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Background" Value="#FCFBF8" />
                <Setter Property="Foreground" Value="#253A62" />
                <Setter Property="BorderBrush" Value="{StaticResource Order.FieldBorder}" />
                <Setter Property="BorderThickness" Value="1" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="BorderBrush" Value="{StaticResource Order.HoverFieldBorder}" />
                        <Setter Property="Background" Value="#F4F6FB" />
                    </Trigger>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                        <Setter Property="BorderBrush" Value="#3559A0" />
                        <Setter Property="Background" Value="White" />
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style TargetType="{x:Type dxe:DateEdit}">
                <!-- لا تحقق تلقائيًا أثناء الكتابة؛ الخطأ يوضع صراحة عند تنفيذ الأمر ويزال عند تعديل القيمة. -->
                <Setter Property="ValidateOnTextInput" Value="False" />
                <Setter Property="ValidateOnEnterKeyPressed" Value="False" />
                <Setter Property="InvalidValueBehavior" Value="AllowLeaveEditor" />
                <EventSetter Event="dxe:BaseEdit.EditValueChanged" Handler="Input_EditValueChanged" />
                <EventSetter Event="dxe:BaseEdit.EditValueChanging" Handler="Input_EditValueChanging" />
                <EventSetter Event="UIElement.PreviewTextInput" Handler="Input_PreviewTextInput" />
                <Setter Property="Height" Value="{DynamicResource Order.FieldHeight}" />
                <Setter Property="FontSize" Value="{DynamicResource Order.FieldFont}" />
                <Setter Property="Mask" Value="dd/MM/yyyy" />
                <Setter Property="MaskUseAsDisplayFormat" Value="True" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="Background" Value="#FCFBF8" />
                <Setter Property="Foreground" Value="#253A62" />
                <Setter Property="BorderBrush" Value="{StaticResource Order.FieldBorder}" />
                <Setter Property="BorderThickness" Value="1" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="BorderBrush" Value="{StaticResource Order.HoverFieldBorder}" />
                        <Setter Property="Background" Value="#F4F6FB" />
                    </Trigger>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                        <Setter Property="BorderBrush" Value="#3559A0" />
                        <Setter Property="Background" Value="White" />
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="ActionButton" TargetType="{x:Type dx:SimpleButton}">
                <Setter Property="Height" Value="{DynamicResource Order.FieldHeight}" />
                <Setter Property="MinWidth" Value="92" />
                <Setter Property="Margin" Value="4,0" />
                <Setter Property="FontSize" Value="{DynamicResource Order.FieldFont}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Background" Value="#F4F6FB" />
                <Setter Property="Foreground" Value="#24564B" />
                <Setter Property="BorderBrush" Value="#CFD9EB" />
            </Style>
            <Style x:Key="AddButton" TargetType="{x:Type dx:SimpleButton}" BasedOn="{StaticResource ActionButton}">
                <Setter Property="ContentTemplate">
                    <Setter.Value>
                        <DataTemplate>
                            <icons:PackIconMaterial Kind="Plus" Style="{StaticResource Order.ChromeIcon}" />
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="Width" Value="38" />
                <Setter Property="MinWidth" Value="38" />
                <Setter Property="Height" Value="{DynamicResource Order.FieldHeight}" />
                <Setter Property="FontSize" Value="23" />
                <Setter Property="Foreground" Value="{StaticResource Order.Accent}" />
                <Setter Property="Background" Value="#EDF2FA" />
            </Style>
            <Style x:Key="ColumnHeader" TargetType="{x:Type dxg:GridColumnHeader}">
                <Setter Property="Background" Value="{StaticResource Order.Accent}" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="FontSize" Value="{DynamicResource Order.LabelFont}" />
                <Setter Property="MinHeight" Value="{DynamicResource Order.GridHeaderHeight}" />
            </Style>
            <Style x:Key="OrderView" TargetType="{x:Type dxg:TableView}">
                <Setter Property="AutoWidth" Value="False" />
                <Setter Property="ShowGroupPanel" Value="False" />
                <Setter Property="AllowEditing" Value="False" />
                <Setter Property="ShowIndicator" Value="False" />
                <Setter Property="RowMinHeight" Value="{DynamicResource Order.GridRowHeight}" />
                <Setter Property="ColumnHeaderStyle" Value="{StaticResource ColumnHeader}" />
            </Style>
            <LinearGradientBrush x:Key="Order.Hero" StartPoint="1,0" EndPoint="0,1">
                <GradientStop Color="#182A50" Offset="0" />
                <GradientStop Color="#324D82" Offset="0.68" />
                <GradientStop Color="#456DB0" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="Order.Canvas" StartPoint="1,0" EndPoint="0,1">
                <GradientStop Color="#F8F9FC" Offset="0" />
                <GradientStop Color="#EDF0F6" Offset="1" />
            </LinearGradientBrush>
            <Style x:Key="Order.WindowButton" TargetType="{x:Type dx:SimpleButton}">
                <Setter Property="Width" Value="38" />
                <Setter Property="Height" Value="34" />
                <Setter Property="Margin" Value="3,0" />
                <Setter Property="Background" Value="#20FFFFFF" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="BorderBrush" Value="#30FFFFFF" />
                <Setter Property="FontSize" Value="17" />
            </Style>
            <Style x:Key="Order.IconField" TargetType="{x:Type Border}">
                <Setter Property="Background" Value="#FCFBF8" />
                <Setter Property="BorderBrush" Value="{StaticResource Order.FieldBorder}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Validation.ErrorTemplate" Value="{StaticResource Order.FieldErrorTemplate}" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="BorderBrush" Value="{StaticResource Order.HoverFieldBorder}" />
                    </Trigger>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                        <Setter Property="BorderBrush" Value="#3559A0" />
                        <Setter Property="Background" Value="White" />
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Opacity" Value="0.55" />
                    </Trigger>
                    <!-- Tag يقرأ قيمة المحرر، والتغميق يزول تلقائيًا عند مسحها. -->
                    <DataTrigger Binding="{Binding Tag, Converter={StaticResource Order.HasInputValue}, RelativeSource={RelativeSource Mode=Self}}" Value="True">
                        <Setter Property="Background" Value="{StaticResource Order.FilledFieldBackground}" />
                        <Setter Property="BorderBrush" Value="{StaticResource Order.FilledFieldBorder}" />
                    </DataTrigger>
                    <!-- الأحمر يتقدم على لون الامتلاء والتركيز عندما تكون قيمة الخانة غير صحيحة. -->
                    <Trigger Property="Validation.HasError" Value="True">
                        <Setter Property="BorderBrush" Value="#DC000C" />
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="Order.FieldIconBadge" TargetType="{x:Type Border}">
                <Setter Property="Background" Value="#EDF1FA" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Width" Value="26" />
                <Setter Property="Height" Value="26" />
                <Setter Property="Margin" Value="3,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="IsHitTestVisible" Value="False" />
                <Setter Property="Focusable" Value="False" />
            </Style>
            <Style x:Key="Order.FieldIcon" TargetType="{x:Type icons:PackIconMaterial}">
                <Setter Property="Width" Value="17" />
                <Setter Property="Height" Value="17" />
                <Setter Property="Foreground" Value="{StaticResource Order.Accent}" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="IsHitTestVisible" Value="False" />
                <Setter Property="Focusable" Value="False" />
            </Style>
            <Style x:Key="Order.ButtonIcon" TargetType="{x:Type icons:PackIconMaterial}">
                <Setter Property="Width" Value="17" />
                <Setter Property="Height" Value="17" />
                <Setter Property="Margin" Value="0,0,7,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type dx:SimpleButton}}}" />
                <Setter Property="IsHitTestVisible" Value="False" />
                <Setter Property="Focusable" Value="False" />
            </Style>
        </ResourceDictionary>
    </mah:MetroWindow.Resources>
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="14" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <mah:MetroWindow.Flyouts>
        <mah:FlyoutsControl FlowDirection="RightToLeft" DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType={x:Type mah:MetroWindow}}}">
            <!-- لوحة الطباعة ومحتواها في التصميم؛ اتجاه الفتح والثيم الحاليان محفوظان. -->
            <!-- لوحة البحث في تكليفات وتقارير إنهاء الصيانة الجانبية؛ الفتح والإغلاق عبر IsOpen مع بقاء الربط والأحداث. -->
            <mah:Flyout x:Name="adv_searsh" Header="البحث في تكليفات وتقارير إنهاء الصيانة" Style="{StaticResource Maintenance.Flyout}" FocusedElement="{Binding ElementName=from_date}" IsOpenChanged="InternalFlyout_IsOpenChanged" Tag="Magnify">
                <Border x:Name="adv_searshCard" Style="{StaticResource Maintenance.Flyout.Card}" MaxWidth="1500">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <orders:MaintenanceFlyoutHeader />

                        <Grid Grid.Row="1" Margin="18">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="0"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="48"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="1">
                                <UniformGrid Columns="4">
                                    <StackPanel Margin="6,3">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="من تاريخ التكليف"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="28"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <CheckBox x:Name="By_Main" Style="{StaticResource Complete.FilterToggle}" AutomationProperties.Name="تفعيل التصفية: من تاريخ التكليف" ToolTip="تفعيل التصفية: من تاريخ التكليف" />
                                            <Border Grid.Column="1" Style="{StaticResource Order.IconField}" Tag="{Binding EditValue, ElementName=from_date, Mode=OneWay}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="36"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Style="{StaticResource Order.FieldIconBadge}">
                                                        <icons:PackIconMaterial Kind="Calendar" Style="{StaticResource Order.FieldIcon}"/>
                                                    </Border>
                                                    <dxe:DateEdit x:Name="from_date" Grid.Column="1" ShowBorder="False" BorderThickness="0" Background="Transparent" IsEnabled="{Binding IsChecked, ElementName=By_Main}" Mask="dd/MM/yyyy" MaskUseAsDisplayFormat="True"/>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel Margin="6,3">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="إلى تاريخ التكليف"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="28"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <CheckBox x:Name="By_Main_To" Style="{StaticResource Complete.FilterToggle}" AutomationProperties.Name="تفعيل التصفية: إلى تاريخ التكليف" ToolTip="تفعيل التصفية: إلى تاريخ التكليف" IsChecked="{Binding IsChecked, ElementName=By_Main, Mode=TwoWay}"/>
                                            <Border Grid.Column="1" Style="{StaticResource Order.IconField}" Tag="{Binding EditValue, ElementName=To_date, Mode=OneWay}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="36"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Style="{StaticResource Order.FieldIconBadge}">
                                                        <icons:PackIconMaterial Kind="Calendar" Style="{StaticResource Order.FieldIcon}"/>
                                                    </Border>
                                                    <dxe:DateEdit x:Name="To_date" Grid.Column="1" ShowBorder="False" BorderThickness="0" Background="Transparent" IsEnabled="{Binding IsChecked, ElementName=By_Main}" Mask="dd/MM/yyyy" MaskUseAsDisplayFormat="True"/>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel Margin="6,3">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="الفني"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="28"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <CheckBox x:Name="By_Emp" Style="{StaticResource Complete.FilterToggle}" AutomationProperties.Name="تفعيل التصفية: الفني" ToolTip="تفعيل التصفية: الفني" />
                                            <Border Grid.Column="1" Style="{StaticResource Order.IconField}" Tag="{Binding EditValue, ElementName=Combo_emp_Search, Mode=OneWay}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="36"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Style="{StaticResource Order.FieldIconBadge}">
                                                        <icons:PackIconMaterial Kind="AccountOutline" Style="{StaticResource Order.FieldIcon}"/>
                                                    </Border>
                                                    <dxe:ComboBoxEdit x:Name="Combo_emp_Search" Grid.Column="1" ShowBorder="False" BorderThickness="0" Background="Transparent" ItemsSource="{Binding Employees}" DisplayMember="Emp_Name" IsEnabled="{Binding IsChecked, ElementName=By_Emp}"/>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel Margin="6,3">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="الخدمة"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="28"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <CheckBox x:Name="By_Service" Style="{StaticResource Complete.FilterToggle}" AutomationProperties.Name="تفعيل التصفية: الخدمة" ToolTip="تفعيل التصفية: الخدمة" />
                                            <Border Grid.Column="1" Style="{StaticResource Order.IconField}" Tag="{Binding EditValue, ElementName=Combo_Services_Search, Mode=OneWay}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="36"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Style="{StaticResource Order.FieldIconBadge}">
                                                        <icons:PackIconMaterial Kind="Tools" Style="{StaticResource Order.FieldIcon}"/>
