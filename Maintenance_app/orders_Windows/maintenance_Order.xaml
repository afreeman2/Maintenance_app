<?xml version="1.0" encoding="utf-8"?>
<mah:MetroWindow x:Class="Maintenance_app.orders_Windows.maintenance_Order" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls" xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core" xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors" xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid" xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks" xmlns:vm="clr-namespace:Maintenance_app.viewo_Model" xmlns:orders="clr-namespace:Maintenance_app.orders_Windows" xmlns:converts="clr-namespace:Maintenance_app.converts" Title="تكليف الصيانة" Width="1920" Height="1080" MinWidth="1000" MinHeight="700" FlowDirection="RightToLeft" WindowStartupLocation="CenterOwner" WindowStyle="None" AllowsTransparency="False" Background="#F0F3F9" BorderThickness="0" ResizeMode="CanResize" Loaded="Order_Loaded" PreviewKeyDown="Order_PreviewKeyDown" WindowState="Maximized" FontFamily="Segoe UI" FontSize="14" dx:ThemeManager.ThemeName="Win11Light" FlyoutOverlayBrush="#90182948" ShowTitleBar="False" ShowCloseButton="False" ShowMinButton="False" ShowMaxRestoreButton="False">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="12" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <mah:MetroWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Maintenance_app;component/Resources/StaticChoices.xaml" />
                <ResourceDictionary Source="/Maintenance_app;component/Resources/MaintenanceFlyouts.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="Dmc.GridCellText"
       TargetType="{x:Type dxe:TextEdit}">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="CornerRadius" Value="0"/>
            </Style>

            <DataTemplate x:Key="CustomHeaderTemplate">
                <DockPanel x:Name="dpHeader" VerticalAlignment="Bottom" LastChildFill="True" Width="0" Height="0" Margin="-10,0,-22,-6" Visibility="Hidden">
                    <Button x:Name="PART_BackButton" Command="{Binding InternalCloseCommand, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type mah:Flyout}}}" CommandParameter="{Binding CloseCommandParameter, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type mah:Flyout}}}" Width="50" Height="50" Margin="2 4 2 2" VerticalAlignment="Bottom" Style="{DynamicResource MahApps.Metro.Styles.MetroCircleButtonStyle}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type mah:Flyout}}}" FontFamily="Segoe UI Symbol" FontSize="16" DockPanel.Dock="Left" Background="{DynamicResource AccentColorBrush}" IsCancel="{Binding CloseButtonIsCancel, RelativeSource={RelativeSource AncestorType={x:Type mah:Flyout}, Mode=FindAncestor}}" Visibility="{Binding CloseButtonVisibility, RelativeSource={RelativeSource AncestorType={x:Type mah:Flyout}, Mode=FindAncestor}}" BorderBrush="#FF191616">
                        <ContentControl Style="{DynamicResource PathIconContentControlStyle}" Content="M19,34V42H43.75L33.75,52H44.25L58.25,38L44.25,24H33.75L43.75,34H19Z" Width="20" Height="20" />
                    </Button>
                    <TextBlock x:Name="PART_BackHeaderText" Margin="0 0 15 0" TextAlignment="Right" VerticalAlignment="Center" Text="{Binding}" Visibility="{Binding TitleVisibility, RelativeSource={RelativeSource AncestorType={x:Type mah:Flyout}, Mode=FindAncestor}}" />
                </DockPanel>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding Position, RelativeSource={RelativeSource AncestorType={x:Type mah:Flyout}}}" Value="Left">
                        <Setter TargetName="PART_BackHeaderText" Property="Margin" Value="15 0 0 0" />
                        <Setter TargetName="PART_BackHeaderText" Property="TextAlignment" Value="Left" />
                        <Setter TargetName="PART_BackButton" Property="DockPanel.Dock" Value="Left" />
                        <Setter TargetName="PART_BackButton" Property="LayoutTransform">
                            <Setter.Value>
                                <ScaleTransform ScaleX="-1" />
                            </Setter.Value>
                        </Setter>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Position, RelativeSource={RelativeSource AncestorType={x:Type mah:Flyout}}}" Value="Top">
                        <Setter TargetName="PART_BackButton" Property="LayoutTransform">
                            <Setter.Value>
                                <RotateTransform Angle="-90" />
                            </Setter.Value>
                        </Setter>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Position, RelativeSource={RelativeSource AncestorType={x:Type mah:Flyout}}}" Value="Bottom">
                        <Setter TargetName="PART_BackButton" Property="LayoutTransform">
                            <Setter.Value>
                                <RotateTransform Angle="270" />
                            </Setter.Value>
                        </Setter>
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>
            <DataTemplate x:Key="ButtonCellTemplate">
                <!-- تمرير بيان الصف إلى حدث الحذف؛ سياق خلية DevExpress يحتوي السجل داخل RowData.Row. -->
                <dx:SimpleButton Click="Service_Delete_click" Tag="{Binding RowData.Row}" IsEnabled="True" ToolTip="حذف بيان الصيانة" AutomationProperties.Name="حذف بيان الصيانة">
                    <icons:PackIconMaterialDesign Foreground="Red" Kind="Delete" Height="22" Width="30" />
                </dx:SimpleButton>
            </DataTemplate>
            <DataTemplate x:Key="ButtonCellTemplate2">
                <!-- تمرير المادة نفسها إلى حدث حذف المواد بدل الاعتماد على الصف المحدد في الجدول. -->
                <dx:SimpleButton Click="Parts_Delete_click" Tag="{Binding RowData.Row}" IsEnabled="True" ToolTip="حذف المادة" AutomationProperties.Name="حذف المادة">
                    <icons:PackIconMaterialDesign Foreground="Red" Kind="Delete" Height="22" Width="30" />
                </dx:SimpleButton>
            </DataTemplate>
            <!-- لون الخانة الممتلئة يحدده وجود EditValue، دون المساس بالقيمة أو قواعد حفظها. -->
            <converts:InputHasValueConverter x:Key="Order.HasInputValue" />
