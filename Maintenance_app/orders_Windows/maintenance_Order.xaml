            <!-- حدود أوضح قليلًا في الحالات العادية والتحويم والامتلاء؛ يبقى لون التركيز الأقوى كما هو. -->
            <SolidColorBrush x:Key="Order.FieldBorder" Color="#A7B6CD" />
            <SolidColorBrush x:Key="Order.HoverFieldBorder" Color="#879DBC" />
            <SolidColorBrush x:Key="Order.FilledFieldBorder" Color="#7C95BC" />
            <converts:BooleanOrConverter x:Key="Order.ValidationVisible" />
            <!-- تحقق الخانات بأسلوب DCMS؛ طبقة الزينة لا تغير مقاسات الخانة أو قيمة الإدخال. -->
            <ControlTemplate x:Key="Order.FieldErrorTemplate">
                <StackPanel Orientation="Vertical" FlowDirection="RightToLeft">
                    <Border BorderThickness="2" BorderBrush="#DC000C" CornerRadius="8" VerticalAlignment="Top" Margin="-1">
                        <Grid>
                            <AdornedElementPlaceholder x:Name="adorner" />
                            <Polygon x:Name="errorCorner" Grid.ZIndex="2" Points="8,8 8,0 0,0" Fill="#DC000C" HorizontalAlignment="Right" VerticalAlignment="Top" />
                            <Polyline Grid.ZIndex="3" Points="7,7 0,0" HorizontalAlignment="Right" VerticalAlignment="Top" Stroke="White" StrokeThickness="1.5" IsHitTestVisible="False" />
                        </Grid>
                    </Border>
                    <Border x:Name="errorMessage" Background="#DC000C" Opacity="0" CornerRadius="3" IsHitTestVisible="False" MinHeight="24" MaxWidth="300" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding ElementName=adorner, Path=AdornedElement.(Validation.Errors)[0].ErrorContent}" Foreground="White" Margin="8,3" TextWrapping="Wrap" FontWeight="SemiBold" />
                    </Border>
                </StackPanel>
                <ControlTemplate.Triggers>
                    <DataTrigger Value="True">
                        <DataTrigger.Binding>
                            <MultiBinding Converter="{StaticResource Order.ValidationVisible}">
                                <Binding ElementName="adorner" Path="AdornedElement.IsKeyboardFocusWithin" />
                                <Binding ElementName="errorCorner" Path="IsMouseOver" />
                            </MultiBinding>
                        </DataTrigger.Binding>
                        <Setter TargetName="errorMessage" Property="Opacity" Value="1" />
                    </DataTrigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
            <SolidColorBrush x:Key="Order.Accent" Color="#3559A0" />
            <Style x:Key="Order.ChromeIcon" TargetType="icons:PackIconMaterial">
                <Setter Property="Width" Value="18" />
                <Setter Property="Height" Value="18" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type dx:SimpleButton}}}" />
                <Setter Property="IsHitTestVisible" Value="False" />
                <Setter Property="Focusable" Value="False" />
            </Style>
            <Style x:Key="FieldLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="{DynamicResource Order.LabelFont}" />
                <Setter Property="Foreground" Value="#4A5874" />
                <Setter Property="Margin" Value="{DynamicResource Order.LabelGap}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style TargetType="dxe:ComboBoxEdit">
                <EventSetter Event="SelectedIndexChanged" Handler="Input_SelectionChanged" />
                <EventSetter Event="PopupContentSelectionChanged" Handler="Input_SelectionChanged" />
                <!-- لا تحقق تلقائيًا أثناء الكتابة؛ الخطأ يوضع صراحة عند تنفيذ الأمر ويزال عند تعديل القيمة. -->
                <Setter Property="ValidateOnTextInput" Value="False" />
                <Setter Property="ValidateOnEnterKeyPressed" Value="False" />
                <Setter Property="InvalidValueBehavior" Value="AllowLeaveEditor" />
                <EventSetter Event="EditValueChanged" Handler="Input_EditValueChanged" />
                <EventSetter Event="EditValueChanging" Handler="Input_EditValueChanging" />
                <EventSetter Event="PreviewTextInput" Handler="Input_PreviewTextInput" />
                <Setter Property="Height" Value="{DynamicResource Order.FieldHeight}" />
                <Setter Property="FontSize" Value="{DynamicResource Order.FieldFont}" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="AutoComplete" Value="True" />
                <Setter Property="IncrementalFiltering" Value="True" />
                <Setter Property="IsTextEditable" Value="True" />
                <Setter Property="NullText" Value="اختر من القائمة" />
                <Setter Property="Background" Value="#FCFBF8" />
                <Setter Property="Foreground" Value="#253A62" />
                <Setter Property="BorderBrush" Value="{StaticResource Order.FieldBorder}" />
                <Setter Property="BorderThickness" Value="1" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="BorderBrush" Value="{StaticResource Order.HoverFieldBorder}" />
                        <Setter Property="Background" Value="#F4F6FB" />
                    </Trigger>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                        <Setter Property="BorderBrush" Value="#3559A0" />
                        <Setter Property="Background" Value="White" />
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style TargetType="dxe:TextEdit">
                <!-- لا تحقق تلقائيًا أثناء الكتابة؛ الخطأ يوضع صراحة عند تنفيذ الأمر ويزال عند تعديل القيمة. -->
                <Setter Property="ValidateOnTextInput" Value="False" />
                <Setter Property="ValidateOnEnterKeyPressed" Value="False" />
                <Setter Property="InvalidValueBehavior" Value="AllowLeaveEditor" />
                <EventSetter Event="EditValueChanged" Handler="Input_EditValueChanged" />
                <EventSetter Event="EditValueChanging" Handler="Input_EditValueChanging" />
                <EventSetter Event="PreviewTextInput" Handler="Input_PreviewTextInput" />
                <Setter Property="Height" Value="{DynamicResource Order.FieldHeight}" />
                <Setter Property="FontSize" Value="{DynamicResource Order.FieldFont}" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Background" Value="#FCFBF8" />
                <Setter Property="Foreground" Value="#253A62" />
                <Setter Property="BorderBrush" Value="{StaticResource Order.FieldBorder}" />
                <Setter Property="BorderThickness" Value="1" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="BorderBrush" Value="{StaticResource Order.HoverFieldBorder}" />
                        <Setter Property="Background" Value="#F4F6FB" />
                    </Trigger>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                        <Setter Property="BorderBrush" Value="#3559A0" />
                        <Setter Property="Background" Value="White" />
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style TargetType="dxe:SpinEdit">
                <!-- لا تحقق تلقائيًا أثناء الكتابة؛ الخطأ يوضع صراحة عند تنفيذ الأمر ويزال عند تعديل القيمة. -->
                <Setter Property="ValidateOnTextInput" Value="False" />
                <Setter Property="ValidateOnEnterKeyPressed" Value="False" />
                <Setter Property="InvalidValueBehavior" Value="AllowLeaveEditor" />
                <EventSetter Event="EditValueChanged" Handler="Input_EditValueChanged" />
                <EventSetter Event="EditValueChanging" Handler="Input_EditValueChanging" />
                <EventSetter Event="PreviewTextInput" Handler="Input_PreviewTextInput" />
                <Setter Property="Height" Value="{DynamicResource Order.FieldHeight}" />
                <Setter Property="FontSize" Value="{DynamicResource Order.FieldFont}" />
                <Setter Property="MinValue" Value="0" />
                <Setter Property="Mask" Value="n3" />
                <Setter Property="MaskUseAsDisplayFormat" Value="True" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Background" Value="#FCFBF8" />
                <Setter Property="Foreground" Value="#253A62" />
                <Setter Property="BorderBrush" Value="{StaticResource Order.FieldBorder}" />
                <Setter Property="BorderThickness" Value="1" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="BorderBrush" Value="{StaticResource Order.HoverFieldBorder}" />
                        <Setter Property="Background" Value="#F4F6FB" />
                    </Trigger>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                        <Setter Property="BorderBrush" Value="#3559A0" />
                        <Setter Property="Background" Value="White" />
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style TargetType="dxe:DateEdit">
                <!-- لا تحقق تلقائيًا أثناء الكتابة؛ الخطأ يوضع صراحة عند تنفيذ الأمر ويزال عند تعديل القيمة. -->
                <Setter Property="ValidateOnTextInput" Value="False" />
                <Setter Property="ValidateOnEnterKeyPressed" Value="False" />
                <Setter Property="InvalidValueBehavior" Value="AllowLeaveEditor" />
                <EventSetter Event="EditValueChanged" Handler="Input_EditValueChanged" />
                <EventSetter Event="EditValueChanging" Handler="Input_EditValueChanging" />
                <EventSetter Event="PreviewTextInput" Handler="Input_PreviewTextInput" />
                <Setter Property="Height" Value="{DynamicResource Order.FieldHeight}" />
                <Setter Property="FontSize" Value="{DynamicResource Order.FieldFont}" />
                <Setter Property="Mask" Value="dd/MM/yyyy" />
                <Setter Property="MaskUseAsDisplayFormat" Value="True" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="Background" Value="#FCFBF8" />
                <Setter Property="Foreground" Value="#253A62" />
                <Setter Property="BorderBrush" Value="{StaticResource Order.FieldBorder}" />
                <Setter Property="BorderThickness" Value="1" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="BorderBrush" Value="{StaticResource Order.HoverFieldBorder}" />
                        <Setter Property="Background" Value="#F4F6FB" />
                    </Trigger>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                        <Setter Property="BorderBrush" Value="#3559A0" />
                        <Setter Property="Background" Value="White" />
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="ActionButton" TargetType="dx:SimpleButton">
                <Setter Property="Height" Value="{DynamicResource Order.FieldHeight}" />
                <Setter Property="MinWidth" Value="92" />
                <Setter Property="Margin" Value="4,0" />
                <Setter Property="FontSize" Value="{DynamicResource Order.FieldFont}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Background" Value="#F4F6FB" />
                <Setter Property="Foreground" Value="#24564B" />
                <Setter Property="BorderBrush" Value="#CFD9EB" />
            </Style>
            <Style x:Key="AddButton" TargetType="dx:SimpleButton" BasedOn="{StaticResource ActionButton}">
                <Setter Property="ContentTemplate">
                    <Setter.Value>
                        <DataTemplate>
                            <icons:PackIconMaterial Kind="Plus" Style="{StaticResource Order.ChromeIcon}" />
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="Width" Value="38" />
                <Setter Property="MinWidth" Value="38" />
                <Setter Property="Height" Value="{DynamicResource Order.FieldHeight}" />
                <Setter Property="FontSize" Value="23" />
                <Setter Property="Foreground" Value="{StaticResource Order.Accent}" />
                <Setter Property="Background" Value="#EDF2FA" />
            </Style>
            <Style x:Key="ColumnHeader" TargetType="dxg:GridColumnHeader">
                <Setter Property="Background" Value="{StaticResource Order.Accent}" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="FontSize" Value="{DynamicResource Order.LabelFont}" />
                <Setter Property="MinHeight" Value="{DynamicResource Order.GridHeaderHeight}" />
            </Style>
            <Style x:Key="OrderView" TargetType="dxg:TableView">
                <Setter Property="AutoWidth" Value="False" />
                <Setter Property="ShowGroupPanel" Value="False" />
                <Setter Property="AllowEditing" Value="False" />
                <Setter Property="ShowIndicator" Value="False" />
                <Setter Property="RowMinHeight" Value="{DynamicResource Order.GridRowHeight}" />
                <Setter Property="ColumnHeaderStyle" Value="{StaticResource ColumnHeader}" />
            </Style>
            <LinearGradientBrush x:Key="Order.Hero" StartPoint="1,0" EndPoint="0,1">
                <GradientStop Color="#182A50" Offset="0" />
                <GradientStop Color="#324D82" Offset="0.68" />
                <GradientStop Color="#456DB0" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="Order.Canvas" StartPoint="1,0" EndPoint="0,1">
                <GradientStop Color="#F8F9FC" Offset="0" />
                <GradientStop Color="#EDF0F6" Offset="1" />
            </LinearGradientBrush>
            <Style x:Key="Order.WindowButton" TargetType="dx:SimpleButton">
                <Setter Property="Width" Value="38" />
                <Setter Property="Height" Value="34" />
                <Setter Property="Margin" Value="3,0" />
                <Setter Property="Background" Value="#20FFFFFF" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="BorderBrush" Value="#30FFFFFF" />
                <Setter Property="FontSize" Value="17" />
            </Style>
            <Style x:Key="Order.IconField" TargetType="Border">
                <Setter Property="Background" Value="#FCFBF8" />
                <Setter Property="BorderBrush" Value="{StaticResource Order.FieldBorder}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Validation.ErrorTemplate" Value="{StaticResource Order.FieldErrorTemplate}" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="BorderBrush" Value="{StaticResource Order.HoverFieldBorder}" />
                    </Trigger>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                        <Setter Property="BorderBrush" Value="#3559A0" />
                        <Setter Property="Background" Value="White" />
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Opacity" Value="0.55" />
                    </Trigger>
                    <!-- Tag يقرأ قيمة المحرر، والتغميق يزول تلقائيًا عند مسحها. -->
                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}, Converter={StaticResource Order.HasInputValue}}" Value="True">
                        <Setter Property="Background" Value="{StaticResource Order.FilledFieldBackground}" />
                        <Setter Property="BorderBrush" Value="{StaticResource Order.FilledFieldBorder}" />
                    </DataTrigger>
                    <!-- الأحمر يتقدم على لون الامتلاء والتركيز عندما تكون قيمة الخانة غير صحيحة. -->
                    <Trigger Property="Validation.HasError" Value="True">
                        <Setter Property="BorderBrush" Value="#DC000C" />
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="Order.FieldIconBadge" TargetType="Border">
                <Setter Property="Background" Value="#EDF1FA" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Width" Value="26" />
                <Setter Property="Height" Value="26" />
                <Setter Property="Margin" Value="3,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="IsHitTestVisible" Value="False" />
                <Setter Property="Focusable" Value="False" />
            </Style>
            <Style x:Key="Order.FieldIcon" TargetType="icons:PackIconMaterial">
                <Setter Property="Width" Value="17" />
                <Setter Property="Height" Value="17" />
                <Setter Property="Foreground" Value="{StaticResource Order.Accent}" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="IsHitTestVisible" Value="False" />
                <Setter Property="Focusable" Value="False" />
            </Style>
            <Style x:Key="Order.ButtonIcon" TargetType="icons:PackIconMaterial">
                <Setter Property="Width" Value="17" />
                <Setter Property="Height" Value="17" />
                <Setter Property="Margin" Value="0,0,7,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type dx:SimpleButton}}}" />
                <Setter Property="IsHitTestVisible" Value="False" />
                <Setter Property="Focusable" Value="False" />
            </Style>
        </ResourceDictionary>

    </mah:MetroWindow.Resources>
    <mah:MetroWindow.Flyouts>
        <mah:FlyoutsControl FlowDirection="RightToLeft" DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType={x:Type mah:MetroWindow}}}">
            <!-- لوحة تعديل بيان الصيانة الجانبية؛ الفتح والإغلاق عبر IsOpen مع بقاء الربط والأحداث. -->
            <mah:Flyout x:Name="Config_Service_Windows" Header="تعديل بيان الصيانة" Style="{StaticResource Maintenance.Flyout}" FocusedElement="{Binding ElementName=Text_dtils_Update}" IsOpenChanged="InternalFlyout_IsOpenChanged" Tag="PencilOutline">
                <Border x:Name="Config_Service_WindowsCard" Style="{StaticResource Maintenance.Flyout.Card}" MaxWidth="850" VerticalAlignment="Center">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <orders:MaintenanceFlyoutHeader />

                        <Grid Grid.Row="1" Margin="18">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="0" />
                                <RowDefinition Height="84" />
                                <RowDefinition Height="84" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="150" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="الإدارة أو القسم" />
                                    <Border Style="{StaticResource Order.IconField}" Tag="{Binding EditValue, ElementName=Combo_Management_Update, Mode=OneWay}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="32" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Style="{StaticResource Order.FieldIconBadge}">
                                                <icons:PackIconMaterial Kind="Domain" Style="{StaticResource Order.FieldIcon}" />
                                            </Border>
                                            <dxe:ComboBoxEdit x:Name="Combo_Management_Update" ItemsSource="{Binding Managements}" DisplayMember="Manag" Grid.Column="1" ShowBorder="False" BorderThickness="0" Background="Transparent" />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="القسم أو الوحدة" />
                                    <Border Style="{StaticResource Order.IconField}" Tag="{Binding EditValue, ElementName=Combo_Department_update, Mode=OneWay}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="32" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Style="{StaticResource Order.FieldIconBadge}">
                                                <icons:PackIconMaterial Kind="SourceBranch" Style="{StaticResource Order.FieldIcon}" />
                                            </Border>
                                            <dxe:ComboBoxEdit x:Name="Combo_Department_update" ItemsSource="{Binding AllDepartments}" DisplayMember="Secti" Grid.Column="1" ShowBorder="False" BorderThickness="0" Background="Transparent" />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="الإجراء" />
                                    <Border Style="{StaticResource Order.IconField}" Tag="{Binding EditValue, ElementName=Combo_Repier_type_Update, Mode=OneWay}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="32" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Style="{StaticResource Order.FieldIconBadge}">
