<mah:MetroWindow xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
                 xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
                 xmlns:notifications="clr-namespace:Maintenance_app.Notifications"
                 xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks"
                 xmlns:workspace="clr-namespace:Maintenance_app.viewo_Model"
                 xmlns:sys="clr-namespace:System;assembly=mscorlib"
                 xmlns:child="http://metro.mahapps.com/winfx/xaml/simplechildwindow" 
                 x:Class="Maintenance_app.MainWindow"
                 Title="مساحة العمل | الخدمات والصيانة" Width="1380" Height="860" MinWidth="1080" 
                 MinHeight="640" WindowStartupLocation="CenterScreen" WindowState="Maximized"
                 ResizeMode="CanResizeWithGrip" WindowStyle="None" AllowsTransparency="True"
                 ShowTitleBar="False" ShowCloseButton="False" ShowMinButton="False" 
                 ShowMaxRestoreButton="False" Loaded="MetroWindow_Loaded" 
                 Closing="MetroWindow_Closing" 
                 TitleAlignment="Center" BorderThickness="0"
                 Background="Transparent" GlowBrush="{x:Null}" 
                 FlowDirection="RightToLeft" FontFamily="Segoe UI" 
                 FontSize="14" UseLayoutRounding="True" SnapsToDevicePixels="True" 
                 TextOptions.TextFormattingMode="Display"
                 
Icon="pack://application:,,,/Maintenance_app;component/Resources/maintenance-crossed-tools.ico"
                 x:Name="MainShell" dx:ThemeManager.ThemeName="Win11Light" WindowButtonCommandsOverlayBehavior="Never" 
                 NonActiveGlowBrush="{x:Null}" IgnoreTaskbarOnMaximize="False">
    <mah:MetroWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Resources/DcmsTheme.xaml"/>
                <ResourceDictionary Source="../Resources/MaintenanceWorkspace.xaml"/>
                <ResourceDictionary Source="../Resources/AccessibleEditors.xaml"/>

            </ResourceDictionary.MergedDictionaries>
            <!-- بالون صغير يتمدد رأسيًا بحسب طول الرسالة. -->
            <Style x:Key="Maintenance.ToastStyle" TargetType="ContentControl">
                <Setter Property="Width" Value="350"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            </Style>
            <DataTemplate x:Key="Maintenance.Toast">
                <Border Width="350" Background="{Binding TintColor}" BorderBrush="{Binding AccentColor}" BorderThickness="1" CornerRadius="10" Padding="12" FlowDirection="RightToLeft">
                    <StackPanel>
                        <DockPanel>
                            <icons:PackIconMaterial Kind="BellRingOutline" Width="19" Height="19" Foreground="{Binding AccentColor}" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding Title}" FontSize="15" Foreground="{Binding AccentColor}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        </DockPanel>
                        <TextBlock Text="{Binding Text}" FontSize="13" Foreground="#405778" TextWrapping="Wrap" Margin="0,5,0,0"/>
                        <TextBlock Text="{Binding ActionHint}" Foreground="{Binding AccentColor}" FontSize="12" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
            </DataTemplate>
            <Style x:Key="Workspace.Secondary" TargetType="dx:SimpleButton" BasedOn="{StaticResource Dcms.SecondaryButton}">
                <Setter Property="Background" Value="{StaticResource Workspace.Tint}"/>
                <Setter Property="Foreground" Value="{StaticResource Workspace.Primary}"/>
            </Style>
            <!-- بطاقة أمر مستقلة بحد واضح، وتفاعل بالفأرة ولوحة المفاتيح دون تغيير أمرها أو صلاحيتها. -->
            <Style x:Key="Workspace.Tile" TargetType="dx:SimpleButton" BasedOn="{StaticResource Dcms.QuickTile}">
                <Setter Property="MinHeight" Value="{DynamicResource Main.QuickButtonHeight}"/>
                <Setter Property="Margin" Value="5,4"/>
                <Setter Property="Padding" Value="8,2"/>
                <Setter Property="Background" Value="White"/>
                <Setter Property="Foreground" Value="{StaticResource Workspace.Ink}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="dx:SimpleButton">
                            <Border x:Name="TileSurface" Background="{TemplateBinding Background}" BorderBrush="#DBE2EE" BorderThickness="1" CornerRadius="10">
                                <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Stretch" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="TileSurface" Property="Background" Value="#F4F7FD"/>
                                    <Setter TargetName="TileSurface" Property="BorderBrush" Value="#A8BAD5"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="TileSurface" Property="BorderBrush" Value="#9C763A"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="TileSurface" Property="Background" Value="#E8EFF9"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.42"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="Workspace.Ribbon" TargetType="dx:SimpleButton" BasedOn="{StaticResource Dcms.RibbonButton}">
                <Setter Property="Height" Value="78"/>
                <Setter Property="MinHeight" Value="78"/>
                <Setter Property="Foreground" Value="{StaticResource Workspace.Primary}"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{StaticResource Workspace.Tint}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>

    </mah:MetroWindow.Resources>

    <Border xmlns:local="clr-namespace:Maintenance_app"
            xmlns:vm="clr-namespace:Maintenance_app.viewo_Model"
            xmlns:conv="clr-namespace:Maintenance_app.converts"
            x:Name="mybo" Background="{StaticResource Workspace.Canvas}"
            BorderBrush="{StaticResource Workspace.Line}" BorderThickness="1"
            CornerRadius="18" Margin="6" vm:RoundedSurface.Radius="18">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="72"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="38"/>
            </Grid.RowDefinitions>
            <Border Background="{StaticResource Workspace.Header}" CornerRadius="18,18,0,0">
                <Grid>
                    <Grid Margin="20,0,12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" MouseLeftButtonDown="TitleSurface_MouseLeftButtonDown">
                            <Border Width="48" Height="48" CornerRadius="13" Background="White" Margin="0,0,14,0">
                                <Image Source="pack://application:,,,/Maintenance_app;component/Resources/ssf Logo.jpg" Stretch="Uniform" Margin="6" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="منظومة الخدمات والصيانة" Foreground="White" FontSize="25" FontWeight="SemiBold"/>
                                <TextBlock Text="صندوق الضمان الاجتماعي" Foreground="#D6E2F3" FontSize="13" Margin="0,5,0,0"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- جرس دائم وعدّاد DevExpress لعدد الإشعارات غير المقروءة. -->
                            <dx:SimpleButton  dx:ThemeManager.ThemeName="Win11Light" x:Name="NotificationBell" Click="NotificationBell_Click" Margin="12,0,16,0" Width="51" Height="42" Background="#3A608F" Foreground="White" ToolTip="إشعارات الصيانة" AutomationProperties.Name="إشعارات الصيانة">
                                <dx:Badge.Badge  >
                                    <dx:Badge x:Name="NoticeBadge" Content="0" Visibility="Collapsed" Background="Red" Foreground="White" AnimationDuration="5"/>
                                </dx:Badge.Badge>
                                <icons:PackIconMaterial Kind="BellOutline" Width="23" Height="23"/>
                            </dx:SimpleButton>
                            <dx:SimpleButton x:Name="MinimizeWindowButton" Click="MinimizeWindow_Click" Style="{StaticResource Dcms.WindowButton}" ToolTip="تصغير" AutomationProperties.Name="تصغير النافذة">
                                <icons:PackIconMaterial Kind="WindowMinimize" Width="17" Height="17"/>
                            </dx:SimpleButton>
                            <dx:SimpleButton x:Name="MaximizeWindowButton" Click="MaximizeWindow_Click" Style="{StaticResource Dcms.WindowButton}" ToolTip="تكبير أو استعادة" AutomationProperties.Name="تكبير أو استعادة النافذة">
                                <icons:PackIconMaterial Width="17" Height="17">
                                    <icons:PackIconMaterial.Style>
                                        <Style TargetType="icons:PackIconMaterial">
                                            <Setter Property="Kind" Value="WindowMaximize"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                                                    <Setter Property="Kind" Value="WindowRestore"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </icons:PackIconMaterial.Style>
                                </icons:PackIconMaterial>
                            </dx:SimpleButton>
                            <dx:SimpleButton x:Name="CloseWindowButton" Click="CloseWindow_Click" Style="{StaticResource Dcms.WindowButton}" Background="#32DF6363" ToolTip="إغلاق المنظومة" AutomationProperties.Name="إغلاق المنظومة">
                                <icons:PackIconMaterial Kind="Close" Width="18" Height="18"/>
                            </dx:SimpleButton>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
            <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource Workspace.Line}" BorderThickness="0,0,0,1">
                <Grid Margin="16,0,24,0">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="TransactionsTab" Content="أوامر الصيانة" Tag="operations" GroupName="WorkspaceSections" Style="{StaticResource Workspace.Tab}" IsChecked="True" Checked="WorkspaceSection_Checked"/>
                        <RadioButton x:Name="ReferenceTab" Content="البيانات المساعدة" Tag="reference" GroupName="WorkspaceSections" Style="{StaticResource Workspace.Tab}" Checked="WorkspaceSection_Checked"/>
                        <RadioButton x:Name="ReportsTab" Content="التقارير" Tag="reports" GroupName="WorkspaceSections" Style="{StaticResource Workspace.Tab}" Checked="WorkspaceSection_Checked"/>
                        <RadioButton x:Name="SettingsTab" Content="الإعدادات" Tag="settings" GroupName="WorkspaceSections" Style="{StaticResource Workspace.Tab}" Checked="WorkspaceSection_Checked"/>
                        <RadioButton x:Name="HelpTab" Content="المساعدة" Tag="help" GroupName="WorkspaceSections" Style="{StaticResource Workspace.Tab}" Checked="WorkspaceSection_Checked"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Border Background="#F1F4F9" BorderBrush="{StaticResource Workspace.Line}" BorderThickness="0,0,0,1" Padding="16,2" Grid.Row="2">
                <workspace:AccessibleWorkspaceItemsControl x:Name="SectionCommands">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <dx:SimpleButton Click="QuickAccess_Click" IsEnabled="{Binding Target.IsEnabled}" Style="{StaticResource Workspace.Ribbon}" Padding="12,4" AutomationProperties.Name="{Binding Title}" AutomationProperties.AcceleratorKey="{Binding Shortcut}" ToolTip="{Binding Description}">
                                <StackPanel>
                                    <icons:PackIconMaterial Kind="{Binding Icon}" Width="20" Height="20" HorizontalAlignment="Center" Margin="0,0,0,3"/>
                                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    <Border Background="{StaticResource Workspace.Tint}" CornerRadius="5" Padding="7,1" Margin="0,3,0,0" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding Shortcut}" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource Workspace.Muted}" FlowDirection="LeftToRight"/>
                                    </Border>
                                </StackPanel>
                            </dx:SimpleButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </workspace:AccessibleWorkspaceItemsControl>
            </Border>
            <Grid ClipToBounds="True" Grid.Row="3" x:Name="WorkspaceCanvas" FlowDirection="LeftToRight">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <!-- خلفية متجهة تملأ مساحة العمل، والرسمة تتمدد دون تشويه أو تداخل مع البطاقات. -->
                <Grid x:Name="WorkspaceBackdrop" Grid.RowSpan="3" Background="{StaticResource Workspace.Canvas}" IsHitTestVisible="False">
                    <Border Background="{StaticResource Workspace.Pattern}"/>
                </Grid>
                <!-- مساحة تعريف بهوية المؤسسة، بخلفية هندسية متجهة تحافظ على حدتها مع التحجيم. -->
                <Border Grid.Row="0" Margin="24,8,24,8" MaxWidth="1580" CornerRadius="16" BorderThickness="1"
                        BorderBrush="#314B70" Background="{StaticResource Workspace.Feature}" IsHitTestVisible="False" ClipToBounds="True">
                    <Grid>
                        <Border Width="4" HorizontalAlignment="Right" Background="#D6B66F" CornerRadius="0,18,18,0"/>
                        <TextBlock x:Name="WorkspaceHeroCompact" Text="صندوق الضمان الاجتماعي  /  الخدمات والصيانة" Visibility="Collapsed"
                                   FontSize="14" Foreground="#F1E4C4" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" FlowDirection="RightToLeft"/>
                        <Grid x:Name="WorkspaceHeroContent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.05*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="20,8,12,8" MaxHeight="370">
                                <Canvas Width="650" Height="310">
                                    <!-- مخطط مبانٍ ومسارات خدمة، مع أدوات الصيانة في بطاقات عائمة. -->
                                    <Ellipse Canvas.Left="70" Canvas.Top="-100" Width="470" Height="470" Fill="#0A8FB6EF" Stroke="#255E82B6"/>
                                    <Ellipse Canvas.Left="110" Canvas.Top="-60" Width="390" Height="390" Stroke="#254D709F"/>
                                    <Path Data="M10,281 H640 M30,296 H590 M75,281 V135 L165,102 V281 M165,281 V72 H325 V281 M325,281 V162 H427 V281 M427,281 V120 H540 V281"
                                          Stroke="#7194C4" StrokeThickness="2" Opacity="0.8"/>
                                    <Path Data="M185,92 H305 M185,121 H305 M185,150 H305 M185,179 H305 M185,208 H305 M185,237 H305 M95,152 H145 M95,179 H145 M95,207 H145 M95,235 H145 M345,184 H405 M345,211 H405 M345,238 H405 M448,143 H519 M448,171 H519 M448,199 H519 M448,227 H519 M230,281 V252 H263 V281"
                                          Stroke="#557CA9" StrokeThickness="5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    <Path Data="M35,235 C110,235 94,36 226,36 C358,36 376,265 608,200" Stroke="#D6B66F" StrokeThickness="2" StrokeDashArray="4 6" Opacity="0.75"/>
                                    <Border Canvas.Left="116" Canvas.Top="29" Width="84" Height="84" Background="#F7F9FE" CornerRadius="22" BorderBrush="#C9D9EF" BorderThickness="1">
                                        <icons:PackIconMaterial Kind="WrenchOutline" Width="41" Height="41" Foreground="#314D7A" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <Border Canvas.Left="474" Canvas.Top="46" Width="64" Height="64" Background="#D6B66F" CornerRadius="18">
                                        <icons:PackIconMaterial Kind="ClipboardCheckOutline" Width="31" Height="31" Foreground="#172944" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <Border Canvas.Left="350" Canvas.Top="230" Width="58" Height="58" Background="#345781" CornerRadius="16" BorderBrush="#6387B5" BorderThickness="1">
                                        <icons:PackIconMaterial Kind="CogOutline" Width="29" Height="29" Foreground="#E2EBFA" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <Ellipse Canvas.Left="47" Canvas.Top="222" Width="10" Height="10" Fill="#D6B66F"/>
                                    <Ellipse Canvas.Left="592" Canvas.Top="193" Width="10" Height="10" Fill="#D6B66F"/>
                                    <Path Data="M565,74 H580 M572.5,66.5 V81.5 M65,74 H77 M71,68 V80" Stroke="#90ACD2" StrokeThickness="2"/>
                                </Canvas>
                            </Viewbox>
                            <Viewbox x:Name="WorkspaceHeroFull" Grid.Column="1" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Right" Margin="20,14,42,14">
                                <StackPanel Width="610" FlowDirection="RightToLeft">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                                        <Border Width="63" Height="59" Background="White" CornerRadius="16" Margin="0,0,14,0">
                                            <Image Source="pack://application:,,,/Maintenance_app;component/Resources/ssf Logo.jpg" Margin="6" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center" Width="407">
                                            <TextBlock Text="صندوق الضمان الاجتماعي" Foreground="#F1E4C4" FontSize="30" FontWeight="SemiBold"/>
                                            <TextBlock Text="إدارة الشؤون الإدارية والخدمات" Foreground="#AFC3E0" FontSize="30" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock Text="الخدمات والصيانة" FontSize="48" FontWeight="Bold" Foreground="White"/>
                                    <TextBlock Text=" تصميم وبرمجة ادارة تقنية المعلومات والاتصالات" Foreground="#F1E4C4" FontSize="30" Margin="0,10,0,0" FontWeight="Bold"/>
                                    <Border Background="#25D6B66F" Height="1" Margin="0,24,0,15"/>
                                    <StackPanel Orientation="Horizontal">
                                        <icons:PackIconMaterial Kind="FileDocumentOutline" Width="18" Height="18" Foreground="#D6B66F" Margin="0,0,7,0"/>
                                        <TextBlock Text="طلبات الصيانة" Foreground="#DCE6F6" FontSize="15"/>
                                        <TextBlock Text=" / " Foreground="#758EB2" Margin="16,0"/>
                                        <TextBlock Text="التكليفات" Foreground="#DCE6F6" FontSize="15"/>
                                        <TextBlock Text=" / " Foreground="#758EB2" Margin="16,0"/>
                                        <TextBlock Text="تقارير الإنهاء" Foreground="#DCE6F6" FontSize="15"/>
                                    </StackPanel>
                                </StackPanel>
                            </Viewbox>
                            <!-- نسخة متوسطة المقاس تبقي العنوان واضحًا بدل تصغير جميع التفاصيل. -->
                            <Grid x:Name="WorkspaceHeroMedium" Grid.Column="1" Visibility="Collapsed" Margin="24,10,34,10" VerticalAlignment="Center" FlowDirection="RightToLeft">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="50" Height="50" CornerRadius="15" Background="White" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <Image Source="pack://application:,,,/Maintenance_app;component/Resources/ssf Logo.jpg" Margin="6" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="صندوق الضمان الاجتماعي" Foreground="#F1E4C4" FontSize="14" Margin="0,0,0,4"/>
                                    <TextBlock Text="الخدمات والصيانة" Foreground="White" FontSize="27" FontWeight="Bold"/>
                                    <TextBlock Text="متابعة الطلبات والتكليفات وتقارير الإنهاء" Foreground="#C6D5EB" FontSize="14" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>
                <!-- صف مستقل بارتفاع المحتوى يضم جميع أزرار الوصول السريع داخل البطاقة. -->
                <Grid Grid.Row="1" Margin="24,8,24,8" MaxWidth="1580" x:Name="QuickSlot">
                    <Border Background="{StaticResource Workspace.Surface}" CornerRadius="14" Padding="14,9" BorderBrush="{StaticResource Workspace.Line}" BorderThickness="1" x:Name="QuickAccessPanel" VerticalAlignment="Top" FlowDirection="RightToLeft">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <icons:PackIconMaterial Kind="ViewDashboardOutline" Width="20" Height="20" Foreground="{StaticResource Workspace.Copper}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="العمليات الرئيسية" FontSize="19" FontWeight="SemiBold" Foreground="{StaticResource Workspace.Ink}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <dx:SimpleButton Grid.Column="1" x:Name="CloseQuickAccessButton" Click="CloseQuickAccess_Click" Content="×" Width="32" Height="32" MinHeight="32" FontSize="22" Style="{StaticResource Workspace.Secondary}" Padding="0" AutomationProperties.Name="إخفاء الوصول السريع"/>
                            </Grid>
                            <workspace:AccessibleWorkspaceItemsControl x:Name="QuickAccessCommands" Grid.Row="1">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <!-- يحسب عدد الصفوف تلقائيًا وفق عدد الأزرار بدل تجاوز الصف الواحد. -->
                                        <UniformGrid Columns="6"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <dx:SimpleButton Click="QuickAccess_Click" IsEnabled="{Binding Target.IsEnabled}" Style="{StaticResource Workspace.Tile}" AutomationProperties.Name="{Binding Title}" AutomationProperties.AcceleratorKey="{Binding Shortcut}">
                                            <dx:SimpleButton.ToolTip>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Description}"/>
                                                    <TextBlock Text="{Binding Shortcut}" FlowDirection="LeftToRight" Margin="0,5,0,0"/>
                                                </StackPanel>
                                            </dx:SimpleButton.ToolTip>
                                            <Grid>
                                                <!-- الأيقونة بجوار العنوان، والاختصار في طرف البطاقة، مع مساحة مرنة لالتفاف العربية. -->
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Width="28" Height="28" Background="{StaticResource Workspace.Tint}" CornerRadius="8" VerticalAlignment="Center" Margin="0,0,7,0">
                                                    <icons:PackIconMaterial Kind="{Binding Icon}" Width="19" Height="19" Foreground="{StaticResource Workspace.Primary}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="{DynamicResource Main.QuickTitleFont}" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,4,0"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Shortcut}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Workspace.Muted}" VerticalAlignment="Center" FlowDirection="LeftToRight"/>
                                            </Grid>
                                        </dx:SimpleButton>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </workspace:AccessibleWorkspaceItemsControl>
                        </Grid>
                    </Border>
                </Grid>
                <dx:SimpleButton x:Name="ShowQuickAccessButton" VerticalAlignment="Bottom" HorizontalAlignment="Left" Content="إظهار الوصول السريع" Click="ShowQuickAccess_Click" Visibility="Collapsed" Style="{StaticResource Workspace.Secondary}" Margin="20"/>
                <Grid Margin="24,4,24,10" MaxWidth="1580" Grid.Row="2" x:Name="StatisticsSlot">
                    <!-- الحالات الخمس تُحسب من آخر تقرير لكل تكليف، وتبقى سنة التكليف هي مرجع التصفية. -->
                    <Border x:Name="StatisticsCard" Background="{StaticResource Workspace.Surface}" BorderBrush="{StaticResource Workspace.Line}"
                            BorderThickness="1" CornerRadius="14" DataContext="{Binding Statistics, ElementName=MainShell}"
                            Padding="16,12" FlowDirection="RightToLeft">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid Margin="4,0,4,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="36"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
