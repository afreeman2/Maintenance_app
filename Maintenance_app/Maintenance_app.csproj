<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <ApplicationIcon>Resources\maintenance-crossed-tools.ico</ApplicationIcon>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Platforms>AnyCPU;x64</Platforms>
    <AssemblyName>Maintenance_app</AssemblyName>
    <PackageId>Maintenance_app</PackageId>
    <Title>منظومة الخدمات والصيانة</Title>
    <Version>3.0.0</Version>
    <AssemblyVersion>3.0.0.0</AssemblyVersion>
    <FileVersion>3.0.0.0</FileVersion>
    <Authors>ادارة تقنية المعلومات والاتصالات</Authors>
    <Company>صندوق الضمان الاجتماعي</Company>
    <Product>منظومة الخدمات والصيانة</Product>
    <Description>منظومة إدارة الخدمات والصيانة</Description>
  </PropertyGroup>

  <!-- يقتصر إخفاء التقارير على الحزمة التي تُبنى صراحةً للفروع. -->
  <PropertyGroup Condition="'$(MaintenanceBranchEdition)' == 'true'">
    <DefineConstants>$(DefineConstants);MAINTENANCE_BRANCH_EDITION</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <!-- مورد أيقونة التطبيق للنوافذ وأيقونة ملف التشغيل. -->
    <Resource Include="Resources\maintenance-crossed-tools.ico" />
  </ItemGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <EmbeddedResource Include="Resources\RequestNotification.wav" LogicalName="Maintenance.RequestNotification.wav" />
    <PackageReference Include="ReportViewerCore.WinForms" Version="15.1.33" />
    <None Remove="Resources\MaintenanceOriginal-mins4.jpg" />
    <Resource Include="Resources\MaintenanceOriginal-mins4.jpg" />
    <None Remove="Resources\CorrespondenceArtwork-v1.png" />
    <None Remove="Resources\IncomingTransactions-icon-v1.png" />
    <None Remove="Resources\IncomingTransactions-v1.ico" />
    <None Remove="Resources\inout4jpg.jpg" />
    <None Remove="Resources\ssf Logo.jpg" />
    <None Remove="Resources\SsfLogo-transparent.png" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="bin\x64\Release\net10.0-windows\Maintenance_app.deps.json" />
