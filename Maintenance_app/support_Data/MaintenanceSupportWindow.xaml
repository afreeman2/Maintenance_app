<mah:MetroWindow x:Class="Maintenance_app.support_Data.MaintenanceSupportWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
    xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:vm="clr-namespace:Maintenance_app.viewo_Model"
                                  xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"

    xmlns:orders="clr-namespace:Maintenance_app.orders_Windows"
    Title="البيانات المساعدة" FlowDirection="RightToLeft"
    Width="650" Height="700" MinWidth="560" MinHeight="430" ResizeMode="CanResizeWithGrip"
                 ShowCloseButton="False" ShowMinButton="False" ShowMaxRestoreButton="False"
             
    WindowStartupLocation="CenterOwner" Background="Transparent" AllowsTransparency="True" WindowStyle="None" ShowTitleBar="False"
    vm:RoundedWindowFrame.Enabled="True" MouseLeftButtonDown="Window_MouseLeftButtonDown"
    BorderThickness="0" dx:ThemeManager.ThemeName="Win11Light" Loaded="Window_Loaded">
    <mah:MetroWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Maintenance_app;component/Resources/MaintenanceFlyouts.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <!-- لون هوية منظومة الصيانة الذي ترثه ترويسة لوحة التعديل. -->
            <SolidColorBrush x:Key="Order.Hero" Color="#213F6A" />
            <Style x:Key="Support.Button" TargetType="dx:SimpleButton">
                <Setter Property="Height" Value="34" /><Setter Property="MinWidth" Value="92" />
                <Setter Property="Padding" Value="10,0" /><Setter Property="Margin" Value="4" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style x:Key="Support.Editor" TargetType="dxe:BaseEdit">
                <Setter Property="Height" Value="34" /><Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" /><Setter Property="Background" Value="White" />
                <Setter Property="BorderBrush" Value="#B8C9E1" /><Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="27,0" />
                <Style.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="#315EA9" /><Setter Property="Background" Value="#E1ECFC" /></Trigger></Style.Triggers>
            </Style>
            <!-- توسيط موحد لعناوين وخلايا جميع جداول البيانات المساعدة. -->
            <DataTemplate x:Key="Support.CenteredCell"><TextBlock Text="{Binding Value}" TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Stretch" TextWrapping="Wrap" Padding="6,2" Foreground="#213F6A" /></DataTemplate>
            <!-- أمر تعديل صريح بالإضافة إلى النقر المزدوج على الصف. -->
            <DataTemplate x:Key="Support.EditCell">
                <dx:SimpleButton Click="Delete_Click" Tag="{Binding RowData.Row}" ToolTip="حذف البيان" Background="#EAF1FB" Foreground="#315EA9" BorderBrush="#B8C9E1" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"><icons:PackIconMaterial Kind="TrashCanOutline" Width="19" Height="19" /></dx:SimpleButton>
            </DataTemplate>
        </ResourceDictionary>
    </mah:MetroWindow.Resources>

    <!-- لوحة التعديل معرفة بالكامل في XAML وتفتح من أسفل النافذة فوق طبقة معتمة. -->
    <mah:MetroWindow.Flyouts>
        <mah:FlyoutsControl FlowDirection="RightToLeft">
            <mah:Flyout x:Name="SupportEditFlyout" Header="تعديل بيان مساعد" Tag="PencilOutline" Style="{StaticResource Maintenance.Flyout}" FocusedElement="{Binding ElementName=NameInput}" IsOpenChanged="SupportEditFlyout_IsOpenChanged">
                <Border Style="{StaticResource Maintenance.Flyout.Card}" MaxWidth="600" VerticalAlignment="Center">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <orders:MaintenanceFlyoutHeader />
                        <Grid Grid.Row="1" Margin="22,18,22,20">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition x:Name="EditDetailsWidth" Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,10,8"><TextBlock x:Name="NameLabel" Foreground="#27476F" FontWeight="SemiBold" Margin="0,0,0,6" /><Grid><dxe:TextEdit x:Name="NameInput" Style="{StaticResource Support.Editor}" MaxLength="50" EditValueChanged="Input_EditValueChanged" NullText="أدخل الاسم" /><icons:PackIconMaterial Kind="FormTextbox" Width="15" Height="15" Margin="0,0,8,0" HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="#315EA9" IsHitTestVisible="False" /></Grid></StackPanel>
                            <StackPanel x:Name="AddressPanel" Grid.Column="1" Margin="0,0,0,8"><TextBlock Text="العنوان" Foreground="#27476F" FontWeight="SemiBold" Margin="0,0,0,6" /><Grid><dxe:TextEdit x:Name="AddressInput" Style="{StaticResource Support.Editor}" MaxLength="150" EditValueChanged="Input_EditValueChanged" NullText="أدخل العنوان" /><icons:PackIconMaterial Kind="MapMarkerOutline" Width="15" Height="15" Margin="0,0,8,0" HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="#315EA9" IsHitTestVisible="False" /></Grid></StackPanel>
                            <StackPanel x:Name="ManagementPanel" Grid.Column="1" Margin="0,0,0,8" Visibility="Collapsed"><TextBlock Text="يتبع الإدارة" Foreground="#27476F" FontWeight="SemiBold" Margin="0,0,0,6" /><Grid><dxe:ComboBoxEdit x:Name="ManagementInput" PopupMaxHeight="220" Style="{StaticResource Support.Editor}" DisplayMember="Manag" IsTextEditable="False" EditValueChanged="Input_EditValueChanged" NullText="اختر الإدارة" /><icons:PackIconMaterial Kind="OfficeBuildingOutline" Width="15" Height="15" Margin="0,0,8,0" HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="#315EA9" IsHitTestVisible="False" /></Grid></StackPanel>
                            <TextBlock x:Name="ValidationText" Grid.Row="1" Grid.ColumnSpan="2" Foreground="#B3261E" FontWeight="SemiBold" Visibility="Collapsed" Margin="2,0,2,10" />
                            <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                                <dx:SimpleButton Click="Save_Click" Style="{StaticResource Support.Button}" Background="#315EA9" Foreground="White"><StackPanel Orientation="Horizontal"><icons:PackIconMaterial Kind="ContentSaveOutline" Width="19" Height="19" Margin="0,0,7,0" /><TextBlock Text="حفظ التعديل" /></StackPanel></dx:SimpleButton>
                                <dx:SimpleButton Click="CancelEdit_Click" Style="{StaticResource Support.Button}" Background="#F4F7FC" Foreground="#28496F" BorderBrush="#C5D2E4"><StackPanel Orientation="Horizontal"><icons:PackIconMaterial Kind="Close" Width="19" Height="19" Margin="0,0,7,0" /><TextBlock Text="إلغاء" /></StackPanel></dx:SimpleButton>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </mah:Flyout>
        </mah:FlyoutsControl>
    </mah:MetroWindow.Flyouts>

    <Border Margin="6" Background="#F6F8FC" BorderBrush="#C9D5E8" BorderThickness="1" CornerRadius="18">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="66" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Border Background="#213F6A" CornerRadius="17,17,0,0" Padding="16,0">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Width="36" Height="36" Background="#D2AB61" CornerRadius="14" Margin="0,0,14,0"><icons:PackIconMaterial Kind="DatabaseEditOutline" Width="21" Height="21" Foreground="#213F6A" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel VerticalAlignment="Center"><TextBlock x:Name="ScreenTitle" FontSize="21" FontWeight="SemiBold" Foreground="White" /><TextBlock x:Name="ScreenSubtitle" FontSize="13" Foreground="#E0E9F7" Margin="0,4,0,0" /></StackPanel></StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><dx:SimpleButton Click="Refresh_Click" Style="{StaticResource Support.Button}" Background="#365A90" Foreground="White"><StackPanel Orientation="Horizontal"><icons:PackIconMaterial Kind="Refresh" Width="19" Height="19" Margin="0,0,7,0" /><TextBlock Text="تحديث" /></StackPanel></dx:SimpleButton>
                        <dx:SimpleButton Click="Close_Click" Width="34" Height="34" MinHeight="34" Padding="0"  FontSize="27"
                                         Foreground="#213F6A" Background="White">
                            <iconPacks:PackIconBootstrapIcons Kind="XCircle" Foreground="{StaticResource Dcms.Primary}" Height="24" Width="26"/>
                        </dx:SimpleButton></StackPanel>
                </Grid>
            </Border>
            <Grid Grid.Row="1" Margin="14,12">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <!-- الإدخال المباشر للإضافة فقط، والتعديل يفتح في اللوحة من صف الجدول. -->
                <Border Background="White" BorderBrush="#D5DFED" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,0,0,10">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition x:Name="AddDetailsWidth" Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock x:Name="AddNameLabel" Foreground="#27476F" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <Grid><dxe:TextEdit x:Name="AddNameInput" Style="{StaticResource Support.Editor}" MaxLength="50" EditValueChanged="Input_EditValueChanged" NullText="أدخل الاسم" /><icons:PackIconMaterial Kind="FormTextbox" Width="15" Height="15" Margin="0,0,8,0" HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="#315EA9" IsHitTestVisible="False" /></Grid>
                            </StackPanel>
                            <StackPanel x:Name="AddAddressPanel" Grid.Column="1">
                                <TextBlock Text="العنوان" Foreground="#27476F" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <Grid><dxe:TextEdit x:Name="AddAddressInput" Style="{StaticResource Support.Editor}" MaxLength="150" EditValueChanged="Input_EditValueChanged" NullText="أدخل العنوان" /><icons:PackIconMaterial Kind="MapMarkerOutline" Width="15" Height="15" Margin="0,0,8,0" HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="#315EA9" IsHitTestVisible="False" /></Grid>
                            </StackPanel>
                            <StackPanel x:Name="AddManagementPanel" Grid.Column="1" Visibility="Collapsed">
                                <TextBlock Text="يتبع الإدارة" Foreground="#27476F" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <Grid><dxe:ComboBoxEdit x:Name="AddManagementInput" PopupMaxHeight="220" Style="{StaticResource Support.Editor}" DisplayMember="Display" IsTextEditable="False" EditValueChanged="Input_EditValueChanged" NullText="اختر الإدارة" /><icons:PackIconMaterial Kind="OfficeBuildingOutline" Width="15" Height="15" Margin="0,0,8,0" HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="#315EA9" IsHitTestVisible="False" /></Grid>
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="AddValidationText" Foreground="#B3261E" FontWeight="SemiBold" Visibility="Collapsed" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                            <dx:SimpleButton Click="Add_Click" Style="{StaticResource Support.Button}" Background="#315EA9" Foreground="White"><StackPanel Orientation="Horizontal"><icons:PackIconMaterial Kind="Plus" Width="16" Height="16" Margin="0,0,6,0" /><TextBlock Text="إضافة بيان" /></StackPanel></dx:SimpleButton>
                            <dx:SimpleButton Click="Delete_Click" Style="{StaticResource Support.Button}" Background="#FFF0F0" Foreground="#A43838" BorderBrush="#E5B3B3"><StackPanel Orientation="Horizontal"><icons:PackIconMaterial Kind="DeleteOutline" Width="16" Height="16" Margin="0,0,6,0" /><TextBlock Text="حذف المحدد" /></StackPanel></dx:SimpleButton>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" Background="White" BorderBrush="#D5DFED" BorderThickness="1" CornerRadius="13" Padding="10">
                    <dxg:GridControl  x:Name="RowsGrid" AutoGenerateColumns="None" MouseDoubleClick="RowsGrid_MouseDoubleClick">
                        <dxg:GridControl.View><dxg:TableView AutoWidth="True" ShowGroupPanel="False" NavigationStyle="Row" AllowEditing="False" ShowIndicator="False"  /></dxg:GridControl.View>
                        <dxg:GridControl.Columns>
                            <dxg:GridColumn Header="حذف" Width="58" HorizontalHeaderContentAlignment="Center" FixedWidth="True" AllowSorting="False" AllowColumnFiltering="False" CellTemplate="{StaticResource Support.EditCell}" />
                            <dxg:GridColumn FieldName="Name" Header="البيان" Width="1.3*" HorizontalHeaderContentAlignment="Center" CellTemplate="{StaticResource Support.CenteredCell}" />
                            <dxg:GridColumn x:Name="DetailsColumn" FieldName="Details" Header="التفاصيل" Width="1.4*" HorizontalHeaderContentAlignment="Center" CellTemplate="{StaticResource Support.CenteredCell}" />
                        </dxg:GridControl.Columns>
                    </dxg:GridControl>
                </Border>
                <TextBlock x:Name="SupportStatus" Grid.Row="2" Foreground="#607B9D" Margin="4,8,4,0" TextWrapping="Wrap" />
            </Grid>
        </Grid>
    </Border>
</mah:MetroWindow>
