<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Maintenance_app;component/Resources/MaintenanceFlyouts.xaml" />
    </ResourceDictionary.MergedDictionaries>
    <!-- الأنماط المشتركة لشاشتي الحسابات وكلمة المرور بهوية الصيانة. -->
    <SolidColorBrush x:Key="Order.Hero" Color="#213F6A" />
    <SolidColorBrush x:Key="Account.InputFilled" Color="#E8F0FC" />
    <Style x:Key="Account.Card" TargetType="Border">
        <Setter Property="Background" Value="#F6F8FC" /><Setter Property="CornerRadius" Value="18" />
        <Setter Property="BorderBrush" Value="#C9D5E8" /><Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style x:Key="Account.Button" TargetType="dx:SimpleButton">
        <Setter Property="Height" Value="36" /><Setter Property="Padding" Value="14,0" />
        <Setter Property="Margin" Value="0,0,8,0" /><Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="Account.Label" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#213F6A" /><Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,5" />
    </Style>
    <Style x:Key="Account.Password" TargetType="PasswordBox">
        <Setter Property="Height" Value="38" /><Setter Property="Padding" Value="28,4" />
        <Setter Property="BorderBrush" Value="#B8C9E1" /><Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="White" /><Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Validation.ErrorTemplate" Value="{DynamicResource errorTemplateSilverlightStyle}" />
    </Style>
</ResourceDictionary>
