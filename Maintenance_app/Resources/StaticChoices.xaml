<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks"
                    xmlns:converts="clr-namespace:Maintenance_app.converts">
  <converts:StaticChoiceIconConverter x:Key="StaticChoice.Icon" />
  <!-- قالب للخيارات المحلية فقط؛ تبقى قيمة الاختيار نصًا كما كانت قبل إضافة الأيقونات. -->
  <DataTemplate x:Key="StaticChoice.Template">
    <Grid FlowDirection="RightToLeft" Margin="6,5" MinHeight="26">
      <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Background="#E5ECF8" CornerRadius="6" Width="26" Height="26" IsHitTestVisible="False">
        <icons:PackIconMaterial Kind="{Binding Converter={StaticResource StaticChoice.Icon}}" Width="17" Height="17" Foreground="#3559A0" VerticalAlignment="Center" HorizontalAlignment="Center" />
      </Border>
      <TextBlock Grid.Column="1" Text="{Binding}" Foreground="#253A62" FontSize="14" Margin="8,0,4,0" VerticalAlignment="Center" />
    </Grid>
  </DataTemplate>
</ResourceDictionary>
