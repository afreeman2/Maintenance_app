<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
                    xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks"
                      xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
  xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
                    xmlns:local="clr-namespace:Maintenance_app.viewo_Model">
    <!-- DCMS layout language, with a royal navy, ivory and muted gold palette. -->
    <SolidColorBrush x:Key="Dcms.Primary" Color="#3559A0"/>
    <SolidColorBrush x:Key="Dcms.Deep" Color="#172747"/>
    <SolidColorBrush x:Key="Dcms.Ink" Color="#2D3347"/>
    <SolidColorBrush x:Key="Dcms.Muted" Color="#687188"/>
    <LinearGradientBrush x:Key="Dcms.Canvas" StartPoint="1,0" EndPoint="0,1">
        <GradientStop Color="#FCFBF8" Offset="0"/>
        <GradientStop Color="#F7F6F3" Offset="0.45"/>
        <GradientStop Color="#EDF0F6" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Dcms.Tint" Color="#EDF1FA"/>
    <SolidColorBrush x:Key="Dcms.Line" Color="#DDE2ED"/>
    <SolidColorBrush x:Key="Dcms.Gold" Color="#C7A052"/>
    <LinearGradientBrush x:Key="Dcms.Hero" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#182A50" Offset="0"/>
        <GradientStop Color="#324D82" Offset="1"/>
    </LinearGradientBrush>
    <Style x:Key="Dcms.IconField" TargetType="Border">
        <Setter Property="local:InputFieldState.Enabled" Value="True"/>
        <Setter Property="Background" Value="#FCFBF8"/>
        <Setter Property="BorderBrush" Value="#CED7E6"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="#97ACD0"/><Setter Property="Background" Value="#F2F5FB"/></Trigger>
            <Trigger Property="local:InputFieldState.HasValue" Value="True"><Setter Property="BorderBrush" Value="#A4B5D6"/><Setter Property="Background" Value="#E9EEF8"/></Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="#3559A0"/><Setter Property="Background" Value="#E9EEF8"/></Trigger>
        </Style.Triggers>
    </Style>
    
    <Style x:Key="Dcms.InputIconBadge" TargetType="Border">
        <Setter Property="Width" Value="24"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="CornerRadius" Value="7"/>
        <Setter Property="Background" Value="#EBF0F9"/>
        <Setter Property="Margin" Value="2,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="Focusable" Value="False"/>
    </Style>
    <Style x:Key="Dcms.WindowButton" TargetType="dx:SimpleButton" BasedOn="{StaticResource Modern.ActionButton}">
        <Setter Property="Width" Value="38"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="Margin" Value="3,0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Background" Value="#22FFFFFF"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style x:Key="Dcms.PrimaryButton" TargetType="dx:SimpleButton" BasedOn="{StaticResource Modern.ActionButton}">
        <Setter Property="Height" Value="48"/>
        <Setter Property="Padding" Value="18,0"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Background" Value="{StaticResource Dcms.Primary}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
    </Style>
    <Style x:Key="Dcms.SecondaryButton" TargetType="dx:SimpleButton" BasedOn="{StaticResource Dcms.PrimaryButton}">
        <Setter Property="Background" Value="{StaticResource Dcms.Tint}"/>
        <Setter Property="Foreground" Value="{StaticResource Dcms.Primary}"/>
    </Style>
    <Style x:Key="Dcms.QuickTile" TargetType="dx:SimpleButton" BasedOn="{StaticResource Dcms.SecondaryButton}">
        <Setter Property="Height" Value="Auto"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="Margin" Value="6"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
    </Style>
    <Style x:Key="Dcms.RibbonButton" TargetType="dx:SimpleButton" BasedOn="{StaticResource Dcms.PrimaryButton}">
        <Setter Property="Height" Value="74"/>
        <Setter Property="MinHeight" Value="74"/>
        <Setter Property="MinWidth" Value="130"/>
        <Setter Property="Padding" Value="12,7"/>
        <Setter Property="Margin" Value="3,3"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource Dcms.Primary}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Dcms.Tint}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Dcms.StatisticsHeader" TargetType="dxg:GridColumnHeader" BasedOn="{StaticResource Modern.GridHeader}">
        <Setter Property="Background" Value="{StaticResource Dcms.Deep}"/>
        <Setter Property="BorderBrush" Value="#45628D"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>
    <Style x:Key="Dcms.DangerButton" TargetType="dx:SimpleButton" BasedOn="{StaticResource Dcms.PrimaryButton}">
        <Setter Property="Background" Value="#FDEDEC"/>
        <Setter Property="Foreground" Value="#AF3C42"/>
    </Style>
    <Style x:Key="Dcms.Field" TargetType="Border">
        <Setter Property="Background" Value="#FAFBFE"/>
        <Setter Property="BorderBrush" Value="#D1D9E8"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Height" Value="52"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="#99ACCD"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource Dcms.Primary}"/>
                <Setter Property="Background" Value="White"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Dcms.Tab" TargetType="RadioButton">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Dcms.Muted}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="22,17"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Surface" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,3">
                        <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="#F4F6FB"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Dcms.Primary}"/>
                            <Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource Dcms.Primary}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="#EBF1FA"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Dcms.CommandRow" TargetType="ListBoxItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Padding" Value="22,18"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="IsEnabled" Value="{Binding Target.IsEnabled}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Surface" BorderBrush="#F0F3F9" BorderThickness="0,0,0,1" Background="White">
                        <Grid>
                            <Border x:Name="Marker" Width="4" Background="{StaticResource Dcms.Primary}" HorizontalAlignment="Left" Visibility="Collapsed"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="#F8F9FC"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="#EDF1FA"/>
                            <Setter TargetName="Marker" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Surface" Property="BorderBrush" Value="#A6B7D8"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Dmc.GridCellText" TargetType="{x:Type dxe:TextEdit}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="0"/>
    </Style>
    <SolidColorBrush x:Key="Dmc.Blue" Color="#0152A4"/>
    <SolidColorBrush x:Key="Dmc.BlueSoft" Color="#EAF2FC"/>
    <SolidColorBrush x:Key="Dmc.Text" Color="#243447"/>
    <SolidColorBrush x:Key="Dmc.Muted" Color="#738195"/>
    <SolidColorBrush x:Key="Dmc.Border" Color="#DCE5EF"/>
    <SolidColorBrush x:Key="Dmc.FieldBackground" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="Dmc.SectionBackground" Color="#F3F7FC"/>
    <SolidColorBrush x:Key="Dmc.Danger" Color="#B42318"/>
    <SolidColorBrush x:Key="Dmc.DangerBackground" Color="#FEF3F2"/>
    <FontFamily x:Key="Dmc.Font">Segoe UI</FontFamily>

    <Style x:Key="Dmc.WindowCard" TargetType="Border">
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="{StaticResource Dmc.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="18"/>
        <Setter Property="TextElement.FontFamily" Value="{StaticResource Dmc.Font}"/>
        <Setter Property="TextElement.Foreground" Value="{StaticResource Dmc.Text}"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="#142D4E" BlurRadius="18" ShadowDepth="3" Opacity="0.16"/>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Dmc.SectionCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Dmc.SectionBackground}"/>
        <Setter Property="BorderBrush" Value="#E1E8F0"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="16"/>
    </Style>
    <Style x:Key="Dmc.FieldLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Dmc.Font}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Dmc.Text}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="Dmc.BaseButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource Dmc.Font}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Height" Value="44"/>
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="Background" Value="{StaticResource Dmc.Blue}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="DmcButtonSurface" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10" SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="DmcButtonSurface" Property="Opacity" Value="0.88"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="DmcButtonSurface" Property="Opacity" Value="0.75"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="DmcButtonSurface" Property="BorderBrush" Value="#8EC5FF"/>
                            <Setter TargetName="DmcButtonSurface" Property="BorderThickness" Value="2"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="DmcButtonSurface" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Dmc.PrimaryButton" TargetType="Button" BasedOn="{StaticResource Dmc.BaseButton}"/>
    <Style x:Key="Dmc.SecondaryButton" TargetType="Button" BasedOn="{StaticResource Dmc.BaseButton}">
        <Setter Property="Background" Value="{StaticResource Dmc.BlueSoft}"/>
        <Setter Property="Foreground" Value="{StaticResource Dmc.Blue}"/>
    </Style>
    <Style x:Key="Dmc.DangerButton" TargetType="Button" BasedOn="{StaticResource Dmc.BaseButton}">
        <Setter Property="Background" Value="{StaticResource Dmc.DangerBackground}"/>
        <Setter Property="Foreground" Value="{StaticResource Dmc.Danger}"/>
    </Style>
    <Style x:Key="Dmc.BaseInput" TargetType="{x:Type dxe:BaseEdit}">
        <Setter Property="FontFamily" Value="{StaticResource Dmc.Font}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="Background" Value="{StaticResource Dmc.FieldBackground}"/>
        <Setter Property="Foreground" Value="{StaticResource Dmc.Text}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Dmc.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="9"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style x:Key="Dmc.TextInput" TargetType="{x:Type dxe:TextEdit}" BasedOn="{StaticResource Dmc.BaseInput}"/>
    <Style x:Key="Dmc.ComboInput" TargetType="{x:Type dxe:ComboBoxEdit}" BasedOn="{StaticResource Dmc.BaseInput}"/>
    <Style x:Key="Dmc.DateInput" TargetType="{x:Type dxe:DateEdit}" BasedOn="{StaticResource Dmc.BaseInput}"/>
    <Style x:Key="Dmc.PasswordInput" TargetType="{x:Type dxe:PasswordBoxEdit}" BasedOn="{StaticResource Dmc.BaseInput}"/>
  
    <Style x:Key="Dmc.ReadOnlyField" TargetType="Label">
        <Setter Property="Background" Value="{StaticResource Dmc.FieldBackground}"/>
        <Setter Property="Foreground" Value="{StaticResource Dmc.Text}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Dmc.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontFamily" Value="{StaticResource Dmc.Font}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock Text="{Binding}" TextWrapping="Wrap" TextAlignment="Center"/>
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Label">
                    <Border CornerRadius="9" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
