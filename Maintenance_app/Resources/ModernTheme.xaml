<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
                    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors">
    <SolidColorBrush x:Key="Modern.Ink" Color="#2D3347" />
    <SolidColorBrush x:Key="Modern.Accent" Color="#3559A0" />
    <SolidColorBrush x:Key="Modern.Canvas" Color="#F7F6F3" />
    <SolidColorBrush x:Key="Modern.Line" Color="#DDE2ED" />

    <Style TargetType="dx:ThemedWindowDialogButton" xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="MinWidth" Value="132"/>
        <Setter Property="MinHeight" Value="42"/>
        <Setter Property="Padding" Value="20,9"/>
        <Setter Property="Margin" Value="5,8,5,10"/>
        <Setter Property="Background" Value="#EDF1FA"/>
        <Setter Property="Foreground" Value="#3559A0"/>
        <Setter Property="BorderBrush" Value="#D0D9EA"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="dx:ThemedWindowDialogButton">
                    <Border x:Name="MessageButton" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9">
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="MessageButton" Property="Opacity" Value="0.85"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="MessageButton" Property="Opacity" Value="0.65"/></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="MessageButton" Property="BorderBrush" Value="#C7A052"/><Setter TargetName="MessageButton" Property="BorderThickness" Value="2"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsDefault" Value="True"><Setter Property="Background" Value="#3559A0"/><Setter Property="Foreground" Value="White"/></Trigger>
            <Trigger Property="Content" Value="إغلاق المنظومة"><Setter Property="Background" Value="#FDEDEC"/><Setter Property="Foreground" Value="#AF3C42"/><Setter Property="BorderBrush" Value="#F2D5D5"/></Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Modern.FormTab" TargetType="TabItem">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="15,12"/>
        <Setter Property="Foreground" Value="#687188"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="TabSurface" Background="#F2F4F9" BorderBrush="Transparent" BorderThickness="0,0,0,3">
                        <ContentPresenter ContentSource="Header" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                                          TextElement.FontSize="14" TextElement.FontWeight="SemiBold"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="TabSurface" Property="Background" Value="White"/><Setter TargetName="TabSurface" Property="BorderBrush" Value="#3559A0"/><Setter Property="Foreground" Value="#3559A0"/></Trigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabSurface" Property="Background" Value="#E5ECF9"/></Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="TabSurface" Property="BorderBrush" Value="#C7A052"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Modern.ActionButton" TargetType="{x:Type dx:SimpleButton}"
           xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type dx:SimpleButton}">
                    <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="8" BorderBrush="Transparent" BorderThickness="2">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.84" /></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.65" /></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#A9C3F2" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="dxg:GridControl">
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="BorderBrush" Value="{StaticResource Modern.Line}" />
        <Setter Property="Foreground" Value="{StaticResource Modern.Ink}" />
        <Setter Property="Background" Value="White" />
    </Style>
    <Style x:Key="Modern.GridHeader" TargetType="dxg:GridColumnHeader">
        <Setter Property="Background" Value="#182A50" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="10,9" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="BorderBrush" Value="#4D6794" />
    </Style>
    <Style TargetType="dxg:TableView">
        <Setter Property="ColumnHeaderStyle" Value="{StaticResource Modern.GridHeader}" />
        <Setter Property="AlternateRowBackground" Value="#F5F7FC" />
        <Setter Property="ShowVerticalLines" Value="False" />
        <Setter Property="ShowHorizontalLines" Value="True" />
    </Style>
    <Style TargetType="dxe:ComboBoxEdit">
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource Modern.Ink}" />
        <Setter Property="BorderBrush" Value="{StaticResource Modern.Line}" />
        <Setter Property="NullText" Value="اختر من القائمة" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style TargetType="dxe:SpinEdit">
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource Modern.Ink}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="AllowNullInput" Value="True" />
        <Setter Property="Mask" Value="n3" />
        <Setter Property="MaskUseAsDisplayFormat" Value="True" />
        <Setter Property="ShowEditorButtons" Value="False" />
    </Style>
</ResourceDictionary>
