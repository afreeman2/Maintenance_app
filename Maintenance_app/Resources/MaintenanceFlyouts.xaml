<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core">
    <!-- ألوان البطاقة من هوية الصيانة؛ الترويسة تقرأ Order.Hero من النافذة المالكة. -->
    <SolidColorBrush x:Key="Maintenance.Flyout.CardBackground" Color="White" />
    <SolidColorBrush x:Key="Maintenance.Flyout.CardBorder" Color="#CAD4E6" />
    <SolidColorBrush x:Key="Maintenance.Flyout.HeaderIcon" Color="#EACD8C" />
    <Style x:Key="Maintenance.Flyout.Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Maintenance.Flyout.CardBackground}" />
        <Setter Property="BorderBrush" Value="{StaticResource Maintenance.Flyout.CardBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="Margin" Value="18" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
    </Style>
    <!-- على نسق DCMS: الرأس الافتراضي بلا مساحة؛ العنوان والإغلاق داخل البطاقة المصممة. -->
    <DataTemplate x:Key="Maintenance.Flyout.HiddenHeader">
        <Grid Width="0" Height="0" Visibility="Collapsed" />
    </DataTemplate>
    <!-- خلفية شفافة وفتح من الأسفل؛ الحجب والإلغاء يحافظان على مسودة المستخدم. -->
    <Style x:Key="Maintenance.Flyout" TargetType="mah:Flyout" BasedOn="{StaticResource MahApps.Styles.Flyout}">
        <Setter Property="Position" Value="Bottom" />
        <Setter Property="IsModal" Value="True" />
        <Setter Property="IsPinned" Value="True" />
        <Setter Property="Theme" Value="Light" />
        <Setter Property="FlowDirection" Value="RightToLeft" />
        <Setter Property="dx:ThemeManager.ThemeName" Value="Win11Light" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="#253A62" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HeaderTemplate" Value="{StaticResource Maintenance.Flyout.HiddenHeader}" />
        <Setter Property="TitleVisibility" Value="Collapsed" />
        <Setter Property="CloseButtonIsCancel" Value="False" />
        <Setter Property="CloseButtonVisibility" Value="Collapsed" />
        <Setter Property="AreAnimationsEnabled" Value="True" />
        <Setter Property="AnimateOnPositionChange" Value="True" />
        <Setter Property="AnimateOpacity" Value="True" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Width" Value="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType={x:Type mah:MetroWindow}}}" />
        <Setter Property="Height" Value="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType={x:Type mah:MetroWindow}}}" />
    </Style>
</ResourceDictionary>
