<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:Maintenance_app.viewo_Model">
    <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="DcmsTheme.xaml"/></ResourceDictionary.MergedDictionaries>
    <Style x:Key="Aux.ChromeButton" TargetType="Button">
        <Setter Property="Width" Value="38"/><Setter Property="Height" Value="36"/>
        <Setter Property="Margin" Value="3,0"/><Setter Property="Background" Value="#18FFFFFF"/>
        <Setter Property="Foreground" Value="White"/><Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontSize" Value="20"/><Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
            <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="9">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#40FFFFFF"/></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#C7A052"/><Setter TargetName="Surface" Property="BorderThickness" Value="2"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Aux.Frame" TargetType="vm:RoundedWindowFrame">
        <Setter Property="Margin" Value="8"/><Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="14"/><Setter Property="Foreground" Value="#2D3347"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="vm:RoundedWindowFrame">
            <Border x:Name="PART_Surface" CornerRadius="18" BorderBrush="#CCD6E9" BorderThickness="1" Background="#F7F7F6F3">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="66"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Background="{StaticResource Dcms.Hero}" CornerRadius="17,17,0,0">
                        <Grid FlowDirection="RightToLeft">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Border x:Name="PART_DragArea" Background="Transparent" Padding="22,0,16,0">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="White" FontSize="22" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="منظومة المعاملات الواردة · إدارة التقاعد العسكري" Foreground="#D4DDEE" FontSize="11" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" FlowDirection="LeftToRight" VerticalAlignment="Center" Margin="12,0">
                                <Button x:Name="PART_Close" Content="×" ToolTip="إغلاق النافذة" AutomationProperties.Name="إغلاق النافذة" Style="{StaticResource Aux.ChromeButton}" Background="#35BA5B5B"/>
                                <Button x:Name="PART_Maximize" Content="□" ToolTip="تكبير / استعادة" AutomationProperties.Name="تكبير أو استعادة النافذة" Style="{StaticResource Aux.ChromeButton}"/>
                                <Button x:Name="PART_Minimize" Content="−" ToolTip="تصغير" AutomationProperties.Name="تصغير النافذة" Style="{StaticResource Aux.ChromeButton}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <ContentPresenter Grid.Row="1" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Margin="{TemplateBinding Padding}"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <DataTrigger Binding="{Binding ResizeMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="CanMinimize">
                    <Setter TargetName="PART_Maximize" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding ResizeMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="NoResize">
                    <Setter TargetName="PART_Maximize" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="PART_Minimize" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Aux.Card" TargetType="Border">
        <Setter Property="CornerRadius" Value="12"/><Setter Property="Background" Value="#FAFFFFFF"/>
        <Setter Property="BorderBrush" Value="#DDE2ED"/><Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="16"/>
    </Style>
    <Style x:Key="Aux.Button" TargetType="Button">
        <Setter Property="Height" Value="44"/><Setter Property="MinWidth" Value="120"/>
        <Setter Property="Padding" Value="14,0"/><Setter Property="Background" Value="#3559A0"/>
        <Setter Property="Foreground" Value="White"/><Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
            <Border x:Name="Surface" CornerRadius="8" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="2">
                <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.86"/></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#C7A052"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.42"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
</ResourceDictionary>
