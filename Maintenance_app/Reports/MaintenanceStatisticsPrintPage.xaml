<UserControl x:Class="Maintenance_app.reports.MaintenanceStatisticsPrintPage"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           Width="794" Height="1123" Background="White">
    <!-- مساحة وهوامش ثابتة لورقة A4، والنص والشرائط يرسمها محرك المستندات. -->
    <StackPanel Margin="48,52,48,0" VerticalAlignment="Top" FlowDirection="RightToLeft"
                TextElement.FontFamily="Segoe UI" TextElement.FontSize="17" TextElement.Foreground="#203B63">
        <DockPanel Margin="0,0,0,24">
            <Image DockPanel.Dock="Right" Source="/Maintenance_app;component/Resources/SsfLogo-transparent.png"
                   Width="70" Height="70" Margin="0,0,18,0" />
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="صندوق الضمان الاجتماعي" FontSize="18" />
                <TextBlock Text="تقرير إحصائية الصيانة" FontSize="30" FontWeight="Bold" />
            </StackPanel>
        </DockPanel>
        <Border BorderBrush="#B88D3E" BorderThickness="0,2,0,0" Padding="0,15,0,20">
            <StackPanel>
                <TextBlock Text="{Binding Period, StringFormat='الفترة · {0}'}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Building, StringFormat='المبنى · {0}'}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding GeneratedAt, StringFormat='تاريخ الطباعة · {0}'}" />
            </StackPanel>
        </Border>
        <TextBlock Text="{Binding Total, StringFormat='إجمالي التكليفات · {0:N0}'}" FontWeight="Bold" FontSize="23" Margin="0,0,0,18" />
        <Border Background="#EAF0F8" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="110" /><ColumnDefinition Width="250" /></Grid.ColumnDefinitions>
                <TextBlock Text="الحالة" FontWeight="Bold" TextAlignment="Center" />
                <TextBlock Grid.Column="1" Text="العدد" FontWeight="Bold" TextAlignment="Center" />
                <TextBlock Grid.Column="2" Text="التوزيع بين الحالات المصنفة" FontWeight="Bold" TextAlignment="Center" />
            </Grid>
        </Border>
        <ItemsControl ItemsSource="{Binding Rows}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="#D4DDEA" BorderThickness="0,0,0,1" Padding="14,15">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="110" /><ColumnDefinition Width="250" /></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Title}" TextAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding Count, StringFormat=N0}" TextAlignment="Center" />
                            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center">
                                <Grid Width="160" Height="11" Background="#EAF0F8" Margin="0,0,10,0">
                                    <Rectangle Fill="#355D90" Width="{Binding BarWidth}" HorizontalAlignment="Right" />
                                </Grid>
                                <TextBlock Width="58" Text="{Binding Share, StringFormat=P1}" TextAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="{Binding Other, StringFormat='تكليفات غير مصنفة · {0:N0}'}" Margin="0,22,0,0" />
    </StackPanel>
</UserControl>
