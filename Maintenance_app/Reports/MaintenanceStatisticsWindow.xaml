<mah:MetroWindow
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks"
   
    xmlns:workspace="clr-namespace:Maintenance_app.viewo_Model"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d" x:Class="Maintenance_app.reports.MaintenanceStatisticsWindow"
    Title="إحصائية الصيانة" FlowDirection="RightToLeft" WindowState="Normal" ShowCloseButton="False"
                 ShowMinButton="False" ShowMaxRestoreButton="False" MinHeight="415"
MinWidth="660" AllowsTransparency="True"
    WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="Transparent"
                 
     ShowTitleBar="False" WindowStyle="None" BorderThickness="0" 
                 dx:ThemeManager.ThemeName="Win11Light" Loaded="Window_Loaded"
                 Height="415" Width="660">
    <mah:MetroWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Maintenance_app;component/Resources/StaticChoices.xaml" />
                <ResourceDictionary Source="/Maintenance_app;component/Resources/MaintenanceFlyouts.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <SolidColorBrush x:Key="Order.Hero" Color="#203B63" />
            <Style x:Key="Statistics.Button" TargetType="{x:Type dx:SimpleButton}">
                <Setter Property="Height" Value="40"/>
                <Setter Property="MinWidth" Value="110"/>
                <Setter Property="Margin" Value="4"/>
                <Setter Property="Padding" Value="14,0"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Style>
        </ResourceDictionary>
    </mah:MetroWindow.Resources>
    <!-- البطاقة المستديرة تبقى ظاهرة، دون نافذة WPF شفافة تسبب تعليق محرك الرسم. -->
    <Border Margin="12" Background="#F6F8FC" BorderBrush="#C9D5E8" BorderThickness="1" CornerRadius="18">
        <Grid >
            <Grid.RowDefinitions>
                <RowDefinition Height="84"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Background="#203B63" CornerRadius="17,17,0,0" Padding="28,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="44" Height="44" Background="#B88D3E" CornerRadius="12" Margin="0,0,14,0">
                            <icons:PackIconMaterial Kind="ChartBoxOutline" Width="27" Height="27" Foreground="#203B63" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="إحصائية الصيانة" FontSize="24" FontWeight="SemiBold" Foreground="White"/>
                            <TextBlock Text="مخططات حالات التكليفات حسب سنة التكليف" FontSize="13" Foreground="#DCE6F6" Margin="0,3,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    <dx:SimpleButton Grid.Column="1" Click="Close_Click" Content="×" Width="38" Height="38" MinHeight="38" FontSize="25" Padding="0" Foreground="#203B63" Background="White" VerticalAlignment="Center" ToolTip="إغلاق"/>
                </Grid>
            </Border>
            <Grid Grid.Row="1" Margin="28,15,28,13">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <!-- نموذج الإحصائية يعيد خيارات muns_chart: مبنى اختياري، سنة واحدة أو فترة، ونوع الفترة. -->
                <Border Background="White" BorderBrush="#D5DFED" BorderThickness="1" CornerRadius="14" Padding="18" Margin="0,0,0,10" Grid.RowSpan="2">
                    <Grid Margin="0,-9,0,-19">

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Top" Margin="57,16,24,0">
                            <CheckBox x:Name="StatisticsBuildingEnabled" Content="حسب المبنى" FontWeight="SemiBold" Foreground="#203B63" Margin="0,0,8,0" Checked="StatisticsFilter_Changed" Unchecked="StatisticsFilter_Changed"/>
                            <workspace:AccessibleStatisticsComboBox x:Name="StatisticsBuilding" Width="331" Height="38" NullText="اختر المبنى" IsEnabled="{Binding IsChecked, ElementName=StatisticsBuildingEnabled}" EditValueChanged="StatisticsFilter_Changed"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Top" Margin="55,76,108,0">
                            <RadioButton x:Name="SingleYearMode" Content=" لـــســنـــة" IsChecked="True" GroupName="StatisticsPeriod" FontWeight="SemiBold" Foreground="#203B63" Checked="StatisticsPeriod_Changed"/>
                            <dxe:SpinEdit x:Name="StatisticsYear" Width="105" Height="38" Margin="8,0,0,0" EditValueType="{x:Type sys:Int32}" Mask="d4" MaskUseAsDisplayFormat="True"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Top" Margin="261,194,19,0">
                            <dx:SimpleButton x:Name="PrintStatisticsButton" Click="Print_Click" Style="{StaticResource Statistics.Button}" Background="#D2AB61" Foreground="#1D385C" BorderBrush="#B58A3D">
                                <StackPanel Orientation="Horizontal">
                                    <icons:PackIconMaterial Kind="PrinterOutline" Width="19" Height="19" Margin="0,0,7,0"/>
                                    <TextBlock Text="طباعة"/>
                                </StackPanel>
                            </dx:SimpleButton>
                            <Button x:Name="cancel_button" Click="Close_Click" BorderBrush="Black" TabIndex="24" FontFamily="Segoe UI" FontSize="16" FontWeight="Bold" Width="113" Height="38" Background="{StaticResource Dmc.BlueSoft}" Style="{StaticResource Dmc.SecondaryButton}" Padding="6,0" Foreground="{StaticResource Dmc.Blue}" BorderThickness="0" Margin="23,0,0,0">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Orientation="Horizontal">
                                    <icons:PackIconMaterialDesign Kind="ExitToApp" Margin="0,0,7,0" Width="18" Height="18" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                                    <TextBlock FontSize="12" VerticalAlignment="Center" Text="إلغاء الأمر" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="52,141,40,0" VerticalAlignment="Top">
                            <RadioButton x:Name="RangeYearsMode" Content=" من سنة" GroupName="StatisticsPeriod" FontWeight="SemiBold" Foreground="#203B63" Checked="StatisticsPeriod_Changed"/>
                            <dxe:SpinEdit x:Name="FromStatisticsYear" Width="105" Height="38" Margin="8,0" EditValueType="{x:Type sys:Int32}" Mask="d4" MaskUseAsDisplayFormat="True" IsEnabled="{Binding IsChecked, ElementName=RangeYearsMode}"/>
                            <TextBlock Text="إلى سنة" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#203B63" Margin="10,0,5,0"/>
                            <dxe:SpinEdit x:Name="ToStatisticsYear" Width="182" Height="38" EditValueType="{x:Type sys:Int32}" Mask="d4" MaskUseAsDisplayFormat="True" IsEnabled="{Binding IsChecked, ElementName=RangeYearsMode}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="261,76,43,0" VerticalAlignment="Top">
                            <TextBlock Text="الفترة" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#203B63" Margin="0,0,8,0"/>
                            <workspace:AccessibleStatisticsComboBox x:Name="StatisticsPeriodType" Width="175" Height="38" IsTextEditable="False" SelectedIndex="3" ItemTemplate="{StaticResource StaticChoice.Template}">
                                <dxe:ComboBoxEdit.ItemsSource>
                                    <x:Array Type="{x:Type sys:String}">
                                        <sys:String>ربع السنة</sys:String>
                                        <sys:String>نصف السنة</sys:String>
                                        <sys:String>ثلاث أربع السنة</sys:String>
                                        <sys:String>سنة كاملة</sys:String>
                                    </x:Array>
                                </dxe:ComboBoxEdit.ItemsSource>
                            </workspace:AccessibleStatisticsComboBox>
                        </StackPanel>
                    </Grid>
                </Border>
                <!-- مخططات WPF خفيفة: لا تستخدم ChartControl الرسومي الذي قد يعلق مع بعض بطاقات العرض. -->
                <!-- مساحة مستقلة للطباعة تضم المخططين الجاريين دون عناصر الفلترة. -->
                <!-- قالب طباعي مستقل داخل XAML: ترويسة وفترة ومجاميع ثم المخططات، لا لقطة خام من واجهة الشاشة. -->
                <Grid Grid.Row="1" Margin="0,22,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</mah:MetroWindow>
