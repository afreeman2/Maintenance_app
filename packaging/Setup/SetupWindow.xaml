<mah:MetroWindow x:Class="MaintenanceSetup.SetupWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    dx:ThemeManager.ThemeName="Win11Light"
    Title="تثبيت منظومة الخدمات والصيانة" Icon="Application.ico"
    Width="630" SizeToContent="Height" MaxHeight="800" MinWidth="480" ResizeMode="CanResizeWithGrip" FontSize="14"
    WindowStartupLocation="CenterScreen" WindowStyle="None" ShowTitleBar="False"
    ShowMinButton="False" ShowMaxRestoreButton="False" ShowCloseButton="False"
    AllowsTransparency="True" Background="Transparent" FlowDirection="RightToLeft"
    Closing="Window_Closing">
    <Border Background="#F4F7FB" BorderBrush="#CAD6E6" BorderThickness="1" CornerRadius="18" Padding="16">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Background="#192E4D" CornerRadius="12" Padding="18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Image Source="Application.ico" Width="49" Height="49" Margin="0,0,12,0"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="تثبيت منظومة الخدمات والصيانة" Foreground="White" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock Text="صندوق الضمان الاجتماعي" Foreground="#E1BB71" FontSize="14" Margin="0,4,0,0"/>
                        </StackPanel>
                        <dx:SimpleButton x:Name="CloseButton" Grid.Column="2" Content="×" Width="35" Height="33" FontSize="19"
                                         Click="Close_Click" AutomationProperties.Name="إغلاق التثبيت"/>
                    </Grid>
                </Border>
                <Border Background="White" BorderBrush="#D8E2EF" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,12,0,0">
                    <StackPanel x:Name="ConnectionFields">
                        <TextBlock Text="إعداد اتصال قاعدة البيانات" FontSize="17" FontWeight="SemiBold" Foreground="#192E4D"/>
                        <Label Content="اسم خادم SQL أو اسم المثيل" Target="{Binding ElementName=ServerName}" Padding="0,9,0,4"/>
                        <TextBox x:Name="ServerName" MinHeight="33" FlowDirection="LeftToRight" TextChanged="Connection_Changed"/>
                        <TextBlock x:Name="ServerError" Foreground="#A52232" Visibility="Collapsed" Text="⚠ أدخل اسم خادم SQL."/>
                        <StackPanel>
                            <Label Content="مستخدم SQL" Target="{Binding ElementName=SqlUser}" Padding="0,8,0,4"/>
                            <TextBox x:Name="SqlUser" MinHeight="33" FlowDirection="LeftToRight" TextChanged="Connection_Changed"/>
                            <TextBlock x:Name="UserError" Foreground="#A52232" Visibility="Collapsed" Text="⚠ أدخل اسم مستخدم SQL."/>
                            <Label Content="كلمة مرور SQL" Target="{Binding ElementName=SqlPassword}" Padding="0,8,0,4"/>
                            <PasswordBox x:Name="SqlPassword" MinHeight="33" FlowDirection="LeftToRight" PasswordChanged="Connection_Changed"/>
                            <TextBlock x:Name="PasswordError" Foreground="#A52232" Visibility="Collapsed" Text="⚠ أدخل كلمة مرور SQL."/>
                        </StackPanel>
                        <Separator Margin="0,10,0,5"/>
                        <!-- يبقى تحديث الملفات هو الوضع الافتراضي، ويُطلب الترحيل صراحة عند أول نقل للبيانات القديمة. -->
                        <CheckBox x:Name="MigrateLegacyData" IsChecked="False" VerticalContentAlignment="Center" Margin="0,5,0,0">
                            <TextBlock Text="ترحيل بيانات Cont_maint لأول مرة" TextWrapping="Wrap" Foreground="#192E4D"/>
                        </CheckBox>
                        <TextBlock Text="يحدّث التثبيت ملفات المنظومة افتراضيًا. فعّل الترحيل فقط لنقل البيانات القديمة إلى قاعدة وجهة فارغة." Foreground="#51617A" TextWrapping="Wrap" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
                <TextBlock x:Name="StatusText" TextWrapping="Wrap" Margin="4,10,4,8" Foreground="#25456A" AutomationProperties.LiveSetting="Polite"/>
                <ProgressBar x:Name="BusyProgress" Height="4" IsIndeterminate="True" Visibility="Collapsed" Margin="0,0,0,9"/>
                <StackPanel Orientation="Horizontal">
                    <dx:SimpleButton x:Name="InstallButton" Content="↓ تثبيت المنظومة" MinWidth="145" Height="36" Click="Install_Click" IsDefault="True"/>
                    <dx:SimpleButton x:Name="TestButton" Content="اختبار الاتصال" MinWidth="120" Height="36" Margin="8,0,0,0" Click="Test_Click"/>
                    <dx:SimpleButton x:Name="LaunchButton" Content="فتح المنظومة" MinWidth="120" Height="36" Margin="8,0,0,0" Visibility="Collapsed" Click="Launch_Click"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Border>
</mah:MetroWindow>
